{
  "$schema": "../corpus/oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "wire/wire-control",
  "corpus": "wire",
  "kind": "runtime",
  "criteria": ["A064", "A065", "A066", "A067", "A068", "A070"],
  "title": "The session protocol over a real transport against the fake core: handshake, version report, every control request valid and invalid, one reasoned stop event per stop, events pushed to a passive observer",
  "notes": "Runs against webserver/debug_gateway with tests/debug/wire/fake_core.py behind it (task Main, probes at program.st lines 3, 4, 6, 7, 9). Plant-free so the same file runs over loopback and from another network namespace. Correlation is checked by the harness session: a response is accepted only for its request's seq.",
  "setup": {"session": "controller"},
  "steps": [
    {"client": "watcher", "request": "initialize", "args": {"role": "observer"}, "note": "passive client: sends nothing more but heartbeats", "expect": {"success": true}},
    {"client": "v2", "request": "initialize", "args": {"protocol": "2.0"}, "expect": {"success": false, "error": "PROTOCOL_VERSION", "body": {"message": {"~ne": ""}, "details": {"client": "2.0", "server": "1.0"}}}},
    {"request": "initialize", "expect": {"success": true, "body": {"protocol": "1.0", "capabilities": {"control": true}, "requests": {"~contains": "pause"}}}},
    {"request": "version", "expect": {"success": true, "body": {"protocol": "1.0", "compiler": "strucpp 0.9.0", "debugInfo": {"major": 1, "minor": 0}, "runtime": {"~ne": ""}}}},
    {"request": "next", "expect": {"success": false, "error": "NOT_HALTED", "body": {"message": {"~ne": ""}}}},
    {"request": "stepIn", "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "stepOut", "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "setBreakpoints", "args": {"file": "missing.st", "lines": [1]}, "expect": {"success": false, "error": "INVALID_LOCATION", "body": {"message": {"~ne": ""}}}},
    {"request": "pause", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST", "body": {"message": {"~ne": ""}}}},
    {"client": "watcher", "request": "pause", "expect": {"success": false, "error": "NOT_CONTROLLER"}},
    {"request": "pause", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause", "task": "Main"}},
    {"client": "watcher", "event": "stopped", "withinMs": 1000, "expect": {"reason": "pause", "task": "Main"}},
    {"request": "continue", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST"}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"client": "watcher", "event": "continued", "withinMs": 500},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": [6]}, "expect": {"success": true, "body": {"breakpoints": [{"line": 6, "verified": true}]}}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": 6, "col": 5}, "task": "Main"}},
    {"request": "next", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST"}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": 7, "col": 5}, "task": "Main"}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main"}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main"}},
    {"request": "clearAllBreakpoints", "expect": {"success": true, "body": {"removed": 1}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"request": "restart", "args": {"kind": "cold", "startHalted": true}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "entry", "location": {"file": "program.st", "line": 3}, "task": "Main"}},
    {"request": "stop", "expect": {"success": true}},
    {"request": "status", "note": "runState events queue up in arrival order; the state is read back", "expect": {"success": true, "body": {"state": "STOPPED"}}},
    {"request": "stop", "expect": {"success": false, "error": "NOT_RUNNING", "body": {"message": {"~ne": ""}}}},
    {"client": "watcher", "event": "runState", "withinMs": 1000, "expect": {"body": {"state": {"~oneOf": ["PAUSED", "HALTED_AT_BP", "RUNNING", "STOPPED"]}}}},
    {"request": "detach", "expect": {"success": true}},
    {"client": "watcher", "event": "control", "withinMs": 1000, "expect": {"body": {"controller": null}}}
  ]
}
