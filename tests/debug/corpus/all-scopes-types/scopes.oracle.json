{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "all-scopes-types/scopes",
  "corpus": "all-scopes-types",
  "kind": "runtime",
  "criteria": ["A013", "A088"],
  "title": "Every scope is listed with its IEC type and value in each frame; a VAR_EXTERNAL resolves to its global",
  "setup": {"session": "controller", "startHalted": true, "plant": {"samplePeriodMs": 10, "inputs": {"%IW0": 3}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "restart", "args": {"kind": "cold", "startHalted": true}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 2000, "expect": {"reason": "entry"}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@HOLDER_FIRST", "@SCALE_FIRST", "@LAST"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@HOLDER_FIRST", "col": 3},
      "stack": [
        {"pou": "Holder", "kind": "fb", "instance": "PROG0.h",
         "scopes": {"inputs": {"in1": 3}, "outputs": {"out1": 0}, "inOuts": {"io": 0}, "temps": {"tmp": 0},
                    "members": {"state": "IDLE"}, "externals": {"G_COUNT": 0, "G_SEG": {"a": {"x": 0, "y": 0}, "b": {"x": 0, "y": 0}, "tag": "IDLE"}}}},
        {"pou": "Scopes", "kind": "program", "instance": "PROG0",
         "scopes": {"members": {"witness": 1, "in_v": 3, "out_v": 0, "shared": 0, "m": "IDLE", "i": 0}, "externals": {"G_COUNT": 0}}}]}},
    {"request": "variables", "args": {"path": "PROG0.segs", "types": true},
     "expect": {"success": true, "body": {"type": "ARRAY[0..1] OF Seg", "elementType": {"name": "Seg", "members": [{"name": "a", "type": "Point"}, {"name": "b", "type": "Point"}, {"name": "tag", "type": "Mode"}]}}}},
    {"request": "variables", "args": {"path": "PROG0.m", "types": true},
     "expect": {"success": true, "body": {"type": "Mode", "values": [["IDLE", 0], ["RUN", 1], ["FAULT", 2]]}}},
    {"request": "variables", "args": {"path": "PROG0.arr", "types": true}, "expect": {"success": true, "body": {"type": "ARRAY[1..4] OF INT", "dims": [[1, 4]]}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@SCALE_FIRST", "col": 3},
      "stack": [
        {"pou": "Scale", "kind": "function", "instance": null, "scopes": {"inputs": {"v": 4}, "inOuts": {"acc": 4}, "temps": {"t": 0}}},
        {"pou": "Scopes", "kind": "program", "instance": "PROG0", "scopes": {"members": {"shared": 4}}}]}},
    {"request": "force", "args": {"path": "G_COUNT", "value": 40, "reason": "external path check"}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@LAST"},
      "variables": {"PROG0.G_COUNT": 40, "G_COUNT": 40, "PROG0.h.G_COUNT": 40, "PROG0.grid[2].x": 43, "PROG0.arr[4]": 12,
                    "PROG0.segs[1].b.y": 3, "G_SEG.a.x": 3, "PROG0.out_v": 8, "PROG0.shared": 12}}},
    {"request": "unforce", "args": {"path": "G_COUNT"}, "expect": {"success": true}},
    {"observe": "plant", "expect": {"witness": {"Main": 0}}}
  ]
}
