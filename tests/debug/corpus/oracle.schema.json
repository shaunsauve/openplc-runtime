{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplc.local/tests/debug/corpus/oracle.schema.json",
  "title": "OpenPLC debug corpus oracle (expected trace), format 1.1",
  "description": "One scenario: scripted gestures and the observations they must produce. Vocabulary from ADR-002 (locations, POUs, instance paths), ADR-003 (requests, events, error codes) and ADR-004 (halt semantics, scan witness, virtual time). Prose: README.md.",
  "type": "object",
  "required": [
    "format",
    "major",
    "minor",
    "scenario",
    "corpus",
    "kind",
    "criteria",
    "title",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "openplc-debug-oracle"
    },
    "major": {
      "const": 1
    },
    "minor": {
      "type": "integer",
      "minimum": 0
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+/[a-z0-9_.-]+$"
    },
    "corpus": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "runtime",
        "build",
        "diagnostic"
      ],
      "description": "`runtime` drives a debug endpoint, `build` reads compiler outputs, and `diagnostic` is a bisect: another scenario with steps cut out, to show that the rest of its evidence still holds. A diagnostic is the only scenario whose `criteria` may be empty, and it must say in `notes` which scenario it is a bisect of and how many steps it removed (validate.py checks the number against that scenario's own step count, so it cannot rot)."
    },
    "criteria": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^A[0-9]{3}$"
      },
      "description": "The criteria this scenario discharges (a subset of the program's header `criteria`) — the claim this file earns, not a label on it. The key is always present, so an oracle can never leave its coverage unstated; the only scenario allowed to list it empty is a `diagnostic`, which writes a `criterion: null` row so its verdict is visible in the ledger as a bisect rather than invisible there."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probes": {
              "type": "boolean"
            },
            "variant": {
              "type": "string"
            },
            "path": {
              "enum": [
                "library",
                "cli",
                "editor"
              ]
            },
            "control": {
              "type": "boolean"
            }
          }
        },
        "haltPolicy": {
          "enum": [
            "hold",
            "safe"
          ]
        },
        "safeValues": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "haltMode": {
          "enum": [
            "allStop",
            "nonStop"
          ]
        },
        "startHalted": {
          "type": "boolean"
        },
        "session": {
          "enum": [
            "none",
            "controller",
            "observer"
          ]
        },
        "plant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "samplePeriodMs": {
              "type": "number",
              "minimum": 0
            },
            "inputs": {
              "$ref": "#/$defs/ioValues"
            },
            "schedule": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "atMs",
                  "set"
                ],
                "additionalProperties": false,
                "properties": {
                  "atMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "set": {
                    "$ref": "#/$defs/ioValues"
                  }
                }
              }
            }
          }
        },
        "tasks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intervalMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/requestStep"
        },
        {
          "$ref": "#/$defs/eventStep"
        },
        {
          "$ref": "#/$defs/noEventStep"
        },
        {
          "$ref": "#/$defs/plantStep"
        },
        {
          "$ref": "#/$defs/waitStep"
        },
        {
          "$ref": "#/$defs/observeStep"
        },
        {
          "$ref": "#/$defs/buildStep"
        },
        {
          "$ref": "#/$defs/injectStep"
        },
        {
          "$ref": "#/$defs/loopStep"
        }
      ]
    },
    "requestStep": {
      "type": "object",
      "required": [
        "request"
      ],
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/command"
        },
        "args": {
          "type": "object"
        },
        "expect": {
          "$ref": "#/$defs/response"
        },
        "note": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "description": "batch: the request is sent this many times back to back (README § Repetition)"
        },
        "client": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "command": {
      "enum": [
        "initialize",
        "attach",
        "detach",
        "terminate",
        "heartbeat",
        "setBreakpoints",
        "setFunctionBreakpoints",
        "setInstanceBreakpoints",
        "setExceptionBreakpoints",
        "breakpointLocations",
        "clearAllBreakpoints",
        "continue",
        "pause",
        "next",
        "stepIn",
        "stepOut",
        "cycleStep",
        "runScans",
        "runToCursor",
        "stop",
        "restart",
        "setHaltMode",
        "threads",
        "stackTrace",
        "scopes",
        "variables",
        "evaluate",
        "setVariable",
        "force",
        "unforce",
        "unforceAll",
        "listForces",
        "subscribe",
        "unsubscribe",
        "traceStart",
        "traceStop",
        "traceRead",
        "source",
        "sync",
        "status",
        "version",
        "requestControl",
        "answerControlRequest",
        "takeControl",
        "releaseControl",
        "setLock",
        "auditRead",
        "classifyChange",
        "applyChange",
        "rebind"
      ],
      "description": "ADR-003 D4 requests, plus classifyChange/applyChange/rebind from ADR-006 (Proposed)"
    },
    "response": {
      "type": "object",
      "required": [
        "success"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/errorCode"
        },
        "body": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "errorCode": {
      "enum": [
        "PROTOCOL_VERSION",
        "UNAUTHORISED",
        "FORBIDDEN",
        "NOT_CONTROLLER",
        "LOCKED",
        "UNSUPPORTED",
        "NO_PROBES",
        "STALE_BUILD",
        "UNSUPPORTED_DEBUG_INFO",
        "INVALID_LOCATION",
        "NO_CODE",
        "NOT_HALTED",
        "NOT_RUNNING",
        "LIMIT_EXCEEDED",
        "BAD_REQUEST",
        "TYPE_ERROR",
        "RANGE_ERROR",
        "EXPR_SIDE_EFFECT",
        "EXPR_LIMIT",
        "EXPR_SYNTAX",
        "NO_SOURCE",
        "BUSY",
        "SESSION_ENDED",
        "INTERNAL",
        "SAFE_STOPPED",
        "CHANGE_REFUSED",
        "CHANGE_FAILED"
      ]
    },
    "eventName": {
      "enum": [
        "stopped",
        "continued",
        "runState",
        "output",
        "values",
        "breakpoint",
        "forces",
        "control",
        "programReplaced",
        "plugin",
        "time",
        "sessionEnded"
      ]
    },
    "eventStep": {
      "type": "object",
      "required": [
        "event"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/eventName"
        },
        "withinMs": {
          "type": "number",
          "minimum": 0
        },
        "notBeforeMs": {
          "type": "number",
          "minimum": 0,
          "description": "The matching event must not arrive earlier than this many ms after the step before this one finished. ONLY for a 'must not fire early' claim (a safe-stop before P2 elapses, a force that expires before its TTL, a heartbeat timeout that must not precede P2): the interval is one the runtime waits out, so contention and load can only lengthen it and never shorten it, and that is what makes a floor safe to assert here. NOT for a responsiveness claim ('stops within 1 s of continue'), where the same contention lengthens the interval and a floor is a false failure on a slow host. The instant is the harness's poll clock at one poll granularity (POLL_MS), which every wait loop drains to keep. With `withinMs` this makes the bound two-sided."
        },
        "count": {
          "$ref": "#/$defs/match",
          "description": "number of the step's client streams that receive a matching event; absent means every one must"
        },
        "expect": {
          "$ref": "#/$defs/eventExpect"
        },
        "note": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "description": "this many successive events of that name"
        },
        "thenContinue": {
          "type": "boolean",
          "description": "after each matched repetition the harness sends continue"
        },
        "client": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "noEventStep": {
      "type": "object",
      "required": [
        "noEvent"
      ],
      "additionalProperties": false,
      "properties": {
        "noEvent": {
          "$ref": "#/$defs/eventName"
        },
        "forMs": {
          "type": "number",
          "minimum": 0
        },
        "forScans": {
          "type": "integer",
          "minimum": 1
        },
        "task": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "eventExpect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "breakpoint",
            "step",
            "pause",
            "entry",
            "exception"
          ]
        },
        "task": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "stack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "variables": {
          "$ref": "#/$defs/varMatches"
        },
        "exception": {
          "$ref": "#/$defs/match"
        },
        "scan": {
          "$ref": "#/$defs/match"
        },
        "vtMs": {
          "$ref": "#/$defs/match"
        },
        "body": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": ["string", "null"],
          "description": "null with line null and boundary true: the scan boundary has no source location (ADR-001 D2.5)"
        },
        "line": {
          "$ref": "#/$defs/lineRef"
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "$ref": "#/$defs/lineRef"
        },
        "boundary": {
          "const": true
        }
      }
    },
    "lineRef": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^@[A-Za-z0-9_]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": [
        "pou",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "pou": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "program",
            "fb",
            "function",
            "method"
          ]
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/varMatches"
          }
        }
      }
    },
    "plantStep": {
      "type": "object",
      "required": [
        "plant"
      ],
      "additionalProperties": false,
      "properties": {
        "plant": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "set": {
              "$ref": "#/$defs/ioValues"
            },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ioValues"
              }
            },
            "failExchanges": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "waitStep": {
      "type": "object",
      "required": [
        "wait"
      ],
      "additionalProperties": false,
      "properties": {
        "wait": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "wallMs": {
              "type": "number",
              "minimum": 0
            },
            "vtMs": {
              "type": "number",
              "minimum": 0
            },
            "scans": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "observeStep": {
      "type": "object",
      "required": [
        "observe",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "observe": {
          "enum": [
            "plant",
            "status",
            "session",
            "log"
          ]
        },
        "expect": {
          "$ref": "#/$defs/observation"
        },
        "throughout": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/client"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "witness": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/match"
          }
        },
        "scanDelta": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/match"
          }
        },
        "vtMs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/match"
          }
        },
        "sinceVtMs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/match"
          },
          "description": "per task: how much PLC virtual time the task gained since the previous plant observation (the scenario's opening plant read for the first one). PLC-time claims only -- 'the virtual clock advanced by N', 'the halt cost N of virtual time'. Virtual time is the PLC's own clock (ADR-004 D4), so the delta is exact whatever the wall clock and the host's load did, which is why it is safe to assert two-sided. A task the plant has reported for neither reading is absent, not zero."
        },
        "outputs": {
          "$ref": "#/$defs/varMatches"
        },
        "variables": {
          "$ref": "#/$defs/varMatches"
        },
        "state": {
          "$ref": "#/$defs/match"
        },
        "fields": {
          "$ref": "#/$defs/match"
        },
        "maxGapMs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/match"
          },
          "description": "per task: the longest stretch in ms between scan-witness increments over the plant samples since the previous plant observation"
        }
      }
    },
    "buildStep": {
      "type": "object",
      "required": [
        "inspect"
      ],
      "additionalProperties": false,
      "properties": {
        "inspect": {
          "enum": [
            "debugInfo",
            "debugMap",
            "generatedCpp",
            "objectCode"
          ]
        },
        "expect": {
          "$ref": "#/$defs/match"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "injectStep": {
      "type": "object",
      "required": [
        "inject"
      ],
      "additionalProperties": false,
      "properties": {
        "inject": {
          "enum": [
            "killClient",
            "dropNetwork",
            "restoreNetwork",
            "sigstopRuntime",
            "sigcontRuntime",
            "killRuntime",
            "restartRuntime",
            "upload",
            "delayNetwork",
            "rawFrame",
            "rest",
            "socket",
            "plugin",
            "writeFile"
          ]
        },
        "args": {
          "type": "object"
        },
        "note": {
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/client"
        },
        "expect": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "ioValues": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "varMatches": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/match"
      }
    },
    "value": {
      "type": [
        "boolean",
        "integer",
        "number",
        "string",
        "null"
      ]
    },
    "match": {
      "description": "A literal (equality, recursively for arrays and objects) or one matcher object whose single key starts with '~'.",
      "oneOf": [
        {
          "type": [
            "boolean",
            "integer",
            "number",
            "string",
            "null",
            "array"
          ]
        },
        {
          "$ref": "#/$defs/matcher"
        },
        {
          "$ref": "#/$defs/objectMatch"
        }
      ]
    },
    "objectMatch": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^~]"
      },
      "additionalProperties": {
        "$ref": "#/$defs/match"
      }
    },
    "matcher": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "additionalProperties": false,
      "properties": {
        "~eq": {
          "$ref": "#/$defs/value"
        },
        "~ne": {
          "$ref": "#/$defs/value"
        },
        "~lt": {
          "type": "number"
        },
        "~le": {
          "type": "number"
        },
        "~gt": {
          "type": "number"
        },
        "~ge": {
          "type": "number"
        },
        "~range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "~approx": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "~oneOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "~display": {
          "type": "string"
        },
        "~capture": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$"
        },
        "~ref": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$"
        },
        "~notRef": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$",
          "description": "differs from the captured value (a build identity that changed, a counter that moved)"
        },
        "~sha256": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$",
          "description": "a string whose SHA-256 (UTF-8, hex) equals the captured value"
        },
        "~contains": {
          "$ref": "#/$defs/match",
          "description": "an array with at least one element matching this, or a string containing this string"
        },
        "~add": {
          "type": "number"
        },
        "~any": {
          "const": true
        },
        "~absent": {
          "const": true
        },
        "~len": {
          "type": "integer",
          "minimum": 0
        },
        "~maxLen": {
          "type": "integer",
          "minimum": 0
        },
        "~tol": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "client": {
      "description": "The client stream(s) a step acts on (README § Clients); absent means \"main\".",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|\\*)$"
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "loopStep": {
      "type": "object",
      "required": [
        "loop",
        "steps"
      ],
      "additionalProperties": false,
      "description": "Run the body steps in order, `loop` times (alternation; README § Repetition)",
      "properties": {
        "loop": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
