{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "retain-200/warm-download-and-restart",
  "corpus": "retain-200",
  "kind": "runtime",
  "criteria": ["A215"],
  "title": "All 200 retained leaves, the located %MW and the WSTRING included, survive a warm full download and a plain restart, restored before the first scan",
  "notes": "ADR-006 D8.6.4 (N1). The upload is the runtime REST upload with no retain option (warm, D8.2). kept_n (%QD2) is the program's own count of non-initial retained leaves; first_* latch the first scan. ASSUMED: the runtime log line names the restored/refused/initial counts as 'restored 200' and 'initial 0'.",
  "setup": {"session": "none", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%ID0": 1000}}},
  "steps": [
    {"wait": {"scans": 3}},
    {"plant": {"set": {"%IX0.0": false}}, "note": "every leaf now holds its plant-set value"},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 1119, "%QD2": 200, "%QW0": 4242}}},
    {"inject": "upload", "args": {"build": "variant-body.st"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "status", "note": "the status API variable read, not the upload response",
     "expect": {"fields": {"variables": {"PROG0.r_dint[0]": 1000, "PROG0.r_dint[119]": 1119, "PROG0.r_int[39]": 40,
       "PROG0.r_real[19]": {"~approx": [1009.5, 0.001]}, "PROG0.r_bool[14]": true, "PROG0.r_time": 42000,
       "PROG0.r_lreal": {"~approx": [3.25, 1e-9]}, "PROG0.r_word": 48879, "PROG0.r_mw": 4242, "PROG0.r_ws": "retained"}}}},
    {"observe": "plant", "note": "the first scan of the new program already ran on the retained values (D8.6.4)",
     "expect": {"outputs": {"%QD3": 1119, "%QD4": 200, "%QW1": 4242, "%QD2": 200, "%QW2": {"~ge": 1}}}},
    {"observe": "log", "expect": {"fields": {"lines": {"~contains": "restored 200"}}}},
    {"observe": "log", "expect": {"fields": {"lines": {"~contains": "initial 0"}}}},
    {"inject": "restartRuntime", "args": {}, "note": "a plain restart of the same program"},
    {"wait": {"scans": 3}},
    {"observe": "status",
     "expect": {"fields": {"variables": {"PROG0.r_dint[0]": 1000, "PROG0.r_dint[119]": 1119, "PROG0.r_mw": 4242, "PROG0.r_ws": "retained",
       "PROG0.r_bool[14]": true, "PROG0.r_time": 42000}}}},
    {"observe": "plant", "note": "leaves 129-200 included: the count is 200, and the first scan saw them",
     "expect": {"outputs": {"%QD3": 1119, "%QD4": 200, "%QW1": 4242, "%QD2": 200}}},
    {"client": "s", "request": "initialize", "args": {"role": "observer"}, "expect": {"success": true}},
    {"inject": "upload", "args": {"build": "program.st"}, "note": "warm again, now with a session attached", "expect": {"status": 200}},
    {"client": "s", "event": "programReplaced", "withinMs": 30000, "expect": {"body": {"cause": "download", "retain": "warm"}}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"outputs": {"%QD3": 1119, "%QD4": 200, "%QW1": 4242, "%QD2": 200}}}
  ]
}
