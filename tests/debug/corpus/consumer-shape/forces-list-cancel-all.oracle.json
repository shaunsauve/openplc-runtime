{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "consumer-shape/forces-list-cancel-all",
  "corpus": "consumer-shape",
  "kind": "runtime",
  "criteria": ["A188"],
  "title": "Every active force is listed with path, value, owner, reason and remaining TTL within 1 s; a user without modify cannot cancel them; cancel-all by A clears every owner's forces in one audited action",
  "notes": "partial: four forces, not five: the legacy 0x42 force needs a PDU client the format lacks (A080); the editor, DAP and CLI views and the editor screenshot are not this harness's. The main stream (A) uses the endpoint's own token. ASSUMED: a detached controller's forces persist (ADR-005 D1.3), so A and B take the controller role in turn.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IX0.1": false, "%IW0": 100, "%IW1": 100}}},
  "steps": [
    {"request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"request": "force", "args": {"path": "PROG_OUT.ao_1", "value": 4321, "reason": "A output"}, "expect": {"success": true}},
    {"event": "forces", "withinMs": 1000, "expect": {"body": {"list": {"~len": 1}}}},
    {"request": "force", "args": {"path": "PROG_IN.di_01", "value": true, "reason": "A input"}, "expect": {"success": true}},
    {"event": "forces", "withinMs": 1000, "expect": {"body": {"list": {"~len": 2}}}},
    {"request": "force", "args": {"path": "G_PLANT.line.m1.run", "value": true, "reason": "A member"}, "expect": {"success": true}},
    {"event": "forces", "withinMs": 1000, "expect": {"body": {"list": {"~len": 3}}}},
    {"request": "detach", "expect": {"success": true}},
    {"client": "b", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:userb"}}, "expect": {"success": true}},
    {"client": "b", "request": "force", "args": {"path": "PROG_OUT.ao_2", "value": 1234, "reason": "B output"}, "expect": {"success": true}},
    {"client": "b", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~len": 4}}}},
    {"client": "b", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~contains": {"path": "PROG_OUT.ao_2", "value": 1234, "owner": "userb", "reason": "B output", "remaining": {"~any": true}}}}}},
    {"client": "b", "request": "detach", "expect": {"success": true}},
    {"client": "nomod", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:ctl_only"}}, "expect": {"success": true}},
    {"client": "nomod", "request": "unforceAll", "expect": {"success": false, "error": "FORBIDDEN"}, "note": "no modify permission"},
    {"client": "nomod", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~len": 4}}}},
    {"client": "nomod", "request": "detach", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QW1": 4321, "%QW2": 1234, "%QX0.0": true}}},
    {"client": "a2", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "a2", "request": "unforceAll", "expect": {"success": true}},
    {"client": "a2", "event": "forces", "withinMs": 1000, "expect": {"body": {"list": {"~len": 0}}}},
    {"wait": {"scans": 1}},
    {"observe": "plant", "note": "logic's values from the next scan", "expect": {"outputs": {"%QW1": 50, "%QW2": 0, "%QX0.0": false}}},
    {"client": "a2", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~len": 0}}}},
    {"client": "a2", "observe": "session", "expect": {"variables": {"PROG_IN.di_01": false, "G_PLANT.line.m1.run": false}}},
    {"client": "adm", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:admin"}}, "expect": {"success": true}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "unforceAll", "count": 4, "outcome": "ok"}}}}}
  ]
}
