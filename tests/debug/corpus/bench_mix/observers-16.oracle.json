{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "bench_mix/observers-16",
  "corpus": "bench_mix",
  "kind": "runtime",
  "criteria": ["A211"],
  "title": "A controller and 16 observers each receive every event; a 17th observer is refused naming the limit",
  "notes": "The jitter and latency budgets of A211 (N012, N018) are measured by the bench instrument over this same sequence. The 17th observer is refused BUSY with details.reason observer_limit (pm ruling, docs/EPICS.md, 2026-10-14).",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": {"group": "obs", "count": 16}, "request": "initialize", "args": {"role": "observer"}, "expect": {"success": true}},
    {"client": {"group": "obs"}, "request": "subscribe", "args": {"paths": {"~leaves": "PROG0", "~count": 1000}, "rateHz": 10}, "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@WITNESS"]}, "expect": {"success": true}},
    {"client": "*", "event": "stopped", "withinMs": 1000, "count": 17, "note": "one per client stream", "expect": {"reason": "breakpoint"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"client": "*", "event": "continued", "withinMs": 500, "count": 17},
    {"client": "extra", "request": "initialize", "args": {"role": "observer"},
     "expect": {"success": false, "error": "BUSY", "body": {"details": {"reason": "observer_limit"}}}},
    {"event": "control", "withinMs": 1000, "expect": {"body": {"observers": {"~len": 16}}}},
    {"wait": {"scans": 10}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 10}}}}
  ]
}
