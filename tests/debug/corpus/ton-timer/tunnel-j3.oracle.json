{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "ton-timer/tunnel-j3",
  "corpus": "ton-timer",
  "kind": "runtime",
  "criteria": ["A083"],
  "title": "J3 (safe halt mid-timing) under the tunnel profile matches its oracle with no heartbeat timeout across the 20 s halt",
  "notes": "ton-timer/halt-mid-timing's steps with event bounds widened by 400 ms.",
  "setup": {"session": "controller", "haltPolicy": "hold", "tasks": {"Main": {"intervalMs": 100}}, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"inject": "delayNetwork", "args": {"rttMs": 300, "jitterMs": 20}, "note": "the tunnel profile: one TCP port, 300 ms +/- 20 ms RTT (P11)"},
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"vtMs": {"Main": {"~capture": "t0"}}, "outputs": {"%QX0.0": false}}},
    {"plant": {"set": {"%IX0.0": true}}},
    {"wait": {"vtMs": 2000}},
    {"request": "pause", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause"}},
    {"observe": "session", "expect": {"variables": {"PROG0.t5.ET": {"~capture": "et", "~range": [1800, 2300]}}}},
    {"observe": "plant", "expect": {"vtMs": {"Main": {"~capture": "vh"}}, "outputs": {"%QD1": {"~capture": "etPlant"}}}},
    {"wait": {"wallMs": 20000}},
    {"observe": "plant", "throughout": true, "note": "ET and virtual time frozen; outputs held; the TON's Q still FALSE", "expect": {"vtMs": {"Main": {"~ref": "vh"}}, "outputs": {"%QD1": {"~ref": "etPlant"}, "%QX0.0": false}}},
    {"observe": "status", "expect": {"state": "PAUSED", "fields": {"watchdogTrips": 0}}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1400, "expect": {"reason": "step"}},
    {"observe": "plant", "expect": {"vtMs": {"Main": {"~ref": "vh", "~add": 100}}}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"vtMs": 2700}},
    {"observe": "plant", "note": "Q at 5 s +/- 1 interval of virtual time after IN, about 5 s + 20 s of wall time", "expect": {"outputs": {"%QX0.0": true, "%QD1": 5000}}},
    {"observe": "status", "expect": {"fields": {"tasks": {"Main": {"maxScanMs": {"~lt": 100}}}}}},
    {"noEvent": "sessionEnded", "forMs": 2000},
    {"inject": "restoreNetwork", "args": {}}
  ]
}
