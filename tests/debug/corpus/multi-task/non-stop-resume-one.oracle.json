{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "multi-task/non-stop-resume-one",
  "corpus": "multi-task",
  "kind": "runtime",
  "criteria": ["A132", "A133", "A175"],
  "title": "J6: all-stop hit, resume all, switch to non-stop in the same session: only the fast task halts and its clock alone stops; resume one, then all",
  "setup": {"session": "controller", "haltMode": "allStop", "plant": {"samplePeriodMs": 5}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FAST_BUMP"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Fast"}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Fast"}},
    {"request": "setHaltMode", "args": {"mode": "nonStop"}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Fast"}},
    {"observe": "plant", "expect": {"witness": {"Fast": {"~capture": "f"}, "Slow": {"~capture": "s"}}, "vtMs": {"Fast": {"~capture": "vf"}, "Slow": {"~capture": "vs"}}}},
    {"wait": {"wallMs": 10000}},
    {"observe": "plant", "note": "fast frozen; slow advances at its interval, its clock by about 10 s", "expect": {
      "witness": {"Fast": {"~ref": "f"}}, "scanDelta": {"Slow": {"~range": [95, 105]}},
      "vtMs": {"Fast": {"~ref": "vf"}, "Slow": {"~ref": "vs", "~add": 10000, "~tol": 200}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FAST_BUMP", "@SLOW_BUMP"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Slow"}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"observe": "plant", "expect": {"witness": {"Fast": {"~ref": "f"}, "Slow": {"~capture": "s2"}}}},
    {"request": "continue", "args": {"task": "Slow"}, "expect": {"success": true}},
    {"wait": {"wallMs": 1000}},
    {"observe": "plant", "note": "only the slow count advances", "expect": {"witness": {"Fast": {"~ref": "f"}}, "scanDelta": {"Slow": {"~ge": 8}}}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "expect": {"scanDelta": {"Fast": {"~ge": 20}, "Slow": {"~ge": 2}}}}
  ]
}
