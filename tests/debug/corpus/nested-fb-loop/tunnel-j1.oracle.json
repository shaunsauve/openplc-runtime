{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "nested-fb-loop/tunnel-j1",
  "corpus": "nested-fb-loop",
  "kind": "runtime",
  "criteria": ["A083"],
  "title": "J1 under the tunnel profile (300 ms RTT) matches its oracle, including a 30 s halt, with no heartbeat timeout",
  "notes": "partial: the self-signed certificate accepted only by explicit option (Negative) is a transport check like A120, not a session step; J3 is ton-timer/tunnel-j3, J4 and J7 plant-io/tunnel-j4-j7. Event bounds are J1's plus 400 ms.",
  "setup": {"session": "controller", "startHalted": true, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"inject": "delayNetwork", "args": {"rttMs": 300, "jitterMs": 20}, "note": "the tunnel profile: one TCP port, 300 ms +/- 20 ms RTT (P11)"},
    {"request": "initialize", "expect": {"success": true}},
    {"request": "restart", "args": {"kind": "cold", "startHalted": true}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 2400, "expect": {"reason": "entry", "location": {"file": "program.st", "line": "@WITNESS"}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_PID"]}, "expect": {"success": true, "body": {"breakpoints": [{"verified": true, "line": "@MOTOR_PID"}]}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1400, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_PID", "col": 5}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_PID"}}, {"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"}}], "variables": {"PROG0.motor1.calls": 1, "PROG0.motor1.speed": 0.0, "PROG0.motor1.enable": true, "PROG0.motor1.target": 50.0, "PROG0.motor1.pid.out": 0.0}}},
    {"wait": {"wallMs": 30000}},
    {"noEvent": "sessionEnded", "forMs": 100},
    {"observe": "status", "note": "no spurious safe-stop over 30 s halted at 300 ms RTT", "expect": {"state": "HALTED_AT_BP"}},
    {"observe": "plant", "note": "stop before the statement: scan 1 not yet published", "expect": {"witness": {"Main": 0}, "outputs": {"%QD2": 0.0}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1400, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_AFTER", "col": 5}, "variables": {"PROG0.motor1.pid.err": 50.0, "PROG0.motor1.pid.integ": {"~approx": [5.0, 1e-06]}, "PROG0.motor1.pid.out": {"~approx": [30.0, 1e-06]}, "PROG0.motor1.speed": 0.0}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 900},
    {"wait": {"scans": 5}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ge": 5}}, "outputs": {"%QD2": {"~gt": 3.0}, "%QD1": 6}}},
    {"noEvent": "stopped", "forScans": 20},
    {"noEvent": "sessionEnded", "forMs": 5000},
    {"inject": "restoreNetwork", "args": {}}
  ]
}
