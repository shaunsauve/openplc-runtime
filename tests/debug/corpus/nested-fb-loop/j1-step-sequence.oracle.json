{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "nested-fb-loop/j1-step-sequence",
  "corpus": "nested-fb-loop",
  "kind": "runtime",
  "criteria": ["A035", "A088"],
  "title": "J1 beats 7-9 on a running program: into the FB, into the nested FB, into the function, out, out, over; the stack's frames, instances and call locations at every stop",
  "notes": "step-sequence's A035 sequence from a breakpoint on a running program instead of a start-halted cold restart (restart and startHalted are U7, T-RC-7/8), so values are judged relative to the stop, not to scan 1. Function scopes are not read: STruCpp emits no __dbg_locals tables, so the function frame's locals have no value (docs/DEBUG_CORE_LINK.md). Seeded red-proof: tests/debug/plant/session_e2e.sh SEED=stepin-over makes step into behave as step over, and the first stepIn lands on @CALL_M2 instead of @MOTOR_FIRST.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CALL_M1"]}, "expect": {"success": true, "body": {"breakpoints": [{"verified": true, "line": "@CALL_M1"}]}}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CALL_M1", "col": 3},
      "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"}}],
      "variables": {"PROG0.motor1.calls": {"~capture": "c"}, "PROG0.witness": {"~capture": "w"}}}},
    {"observe": "plant", "note": "the plant holds the last complete scan, one behind the program's witness", "expect": {"witness": {"Main": {"~ref": "w", "~add": -1}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_FIRST", "col": 3},
      "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_FIRST"}},
                {"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"}}]}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "note": "over the comment line to the IF", "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_IF", "col": 3},
      "variables": {"PROG0.motor1.calls": {"~ref": "c", "~add": 1}}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_PID", "col": 5},
      "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1",
                 "scopes": {"inputs": {"enable": true, "target": 50.0}, "members": {"calls": {"~ref": "c", "~add": 1}}}},
                {"pou": "Cell", "kind": "program", "instance": "PROG0"}]}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@PID_FIRST", "col": 3},
      "stack": [{"pou": "PidCtl", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_FIRST"}},
                {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_PID"}},
                {"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"}}]}},
    {"loop": 2, "steps": [
      {"request": "next", "expect": {"success": true}},
      {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step"}}]},
    {"request": "stepIn", "note": "now at @PID_CALL; into the function", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@CLAMP_FIRST", "col": 3},
      "stack": [{"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_FIRST"}},
                {"pou": "PidCtl", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_CALL"},
                 "scopes": {"inputs": {"sp": 50.0}, "members": {"kp": 0.5, "ki": {"~approx": [0.1, 1e-6]}}}},
                {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_PID"}},
                {"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"},
                 "scopes": {"members": {"witness": {"~ref": "w"}, "total": 6}}}]}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@PID_AFTER", "col": 3},
      "stack": [{"pou": "PidCtl", "kind": "fb", "instance": "PROG0.motor1.pid"}, {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"},
                {"pou": "Cell", "kind": "program", "instance": "PROG0"}]}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_AFTER", "col": 5},
      "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"}, {"pou": "Cell", "kind": "program", "instance": "PROG0"}]}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "note": "past the FB's last statement: back in the caller at the next statement",
     "expect": {"reason": "step", "location": {"file": "program.st", "line": "@CALL_M2", "col": 3},
      "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0"}], "variables": {"PROG0.witness": {"~ref": "w"}}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"noEvent": "stopped", "forScans": 10},
    {"observe": "plant", "throughout": true, "expect": {"scanDelta": {"Main": {"~ge": 10}}}}
  ]
}
