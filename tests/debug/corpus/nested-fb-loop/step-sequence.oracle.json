{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "nested-fb-loop/step-sequence",
  "corpus": "nested-fb-loop",
  "kind": "runtime",
  "criteria": ["A035", "A088"],
  "title": "Step over, into FB, into nested FB, into function, out, out, over; stack and scopes per frame",
  "setup": {"session": "controller", "startHalted": true, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "restart", "args": {"kind": "cold", "startHalted": true}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 2000, "expect": {"reason": "entry", "location": {"file": "program.st", "line": "@WITNESS"}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@CALL_M1"},
      "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0"}], "variables": {"PROG0.witness": 1}}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_FIRST", "col": 3},
      "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"}, {"pou": "Cell", "kind": "program", "instance": "PROG0"}]}},
    {"request": "next", "repeat": 2, "expect": {"success": true}},
    {"event": "stopped", "repeat": 2, "withinMs": 1000, "expect": {"reason": "step"}},
    {"request": "stepIn", "note": "now at @MOTOR_PID; into the nested FB", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@PID_FIRST", "col": 3},
      "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid"}, {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"},
                {"pou": "Cell", "kind": "program", "instance": "PROG0"}]}},
    {"request": "next", "repeat": 2, "expect": {"success": true}},
    {"event": "stopped", "repeat": 2, "withinMs": 1000, "expect": {"reason": "step"}},
    {"request": "stepIn", "note": "now at @PID_CALL; into the function", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@CLAMP_FIRST", "col": 3},
      "stack": [
        {"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_FIRST"},
         "scopes": {"inputs": {"v": {"~approx": [30.0, 1e-6]}, "lo": 0.0, "hi": 100.0}, "temps": {"r": 0.0}}},
        {"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_CALL"},
         "scopes": {"inputs": {"sp": 50.0, "pv": 0.0}, "outputs": {"out": 0.0},
                    "members": {"kp": 0.5, "ki": {"~approx": [0.1, 1e-6]}, "err": 50.0, "integ": {"~approx": [5.0, 1e-6]}, "last": 0.0}}},
        {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_PID"},
         "scopes": {"inputs": {"enable": true, "target": 50.0}, "outputs": {"speed": 0.0}, "members": {"calls": 1}}},
        {"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"},
         "scopes": {"members": {"witness": 1, "total": 0, "i": 0}}}]}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@PID_AFTER", "col": 3},
      "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid"}, {"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"},
                {"pou": "Cell", "kind": "program", "instance": "PROG0"}],
      "variables": {"PROG0.motor1.pid.out": {"~approx": [30.0, 1e-6]}}}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@MOTOR_AFTER", "col": 5},
      "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1"}, {"pou": "Cell", "kind": "program", "instance": "PROG0"}],
      "variables": {"PROG0.motor1.pid.last": {"~approx": [30.0, 1e-6]}, "PROG0.motor1.speed": 0.0}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "note": "past the FB's last statement: back in the caller at the next statement",
     "expect": {"reason": "step", "location": {"file": "program.st", "line": "@CALL_M2", "col": 3},
      "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0"}], "variables": {"PROG0.motor1.speed": {"~approx": [3.0, 1e-6]}}}},
    {"observe": "plant", "throughout": true, "expect": {"witness": {"Main": 0}}}
  ]
}
