{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "nested-fb-loop/probe-map",
  "corpus": "nested-fb-loop",
  "kind": "runtime",
  "criteria": ["A011"],
  "title": "Every executable statement has a probe; a breakpoint on each line stops there with the POU and instance path the debug info names",
  "notes": "The stops follow one scan in execution order (motor2 disabled), so each next breakpoint is the next one reached. @CLAMP_LO and @CLAMP_HI are listed but not visited: with these inputs the clamp argument stays inside [0, 100]. ASSUMED: the ELSIF and FOR lines carry condition probes (ADR-002 D3 probe kinds 1 and 2); their column is not asserted. corpus:consumer-shape, also cited by A011, has no scenario of this kind yet.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"inspect": "debugInfo", "note": "every executable statement line, and nothing else (no declaration, comment, blank or END line)", "expect": {"build": {"probes": true}, "linesByFile": {"program.st": ["@CLAMP_FIRST", "@CLAMP_IF", "@CLAMP_LO", "@CLAMP_ELSIF", "@CLAMP_HI", "@CLAMP_RET", "@PID_FIRST", "@PID_INTEG", "@PID_CALL", "@PID_AFTER", "@MOTOR_FIRST", "@MOTOR_IF", "@MOTOR_PID", "@MOTOR_AFTER", "@MOTOR_ELSE", "@WITNESS", "@CALL_M1", "@CALL_M2", "@TOTAL", "@FOR", "@FOR_BODY", "@AFTER_LOOP"]}}},
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@WITNESS"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@WITNESS", "col": 3}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@WITNESS"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CALL_M1"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CALL_M1", "col": 3}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M1"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_FIRST"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_FIRST", "col": 3}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_FIRST"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_IF"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_IF", "col": 3}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_IF"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_PID"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_PID", "col": 5}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_PID"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@PID_FIRST"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@PID_FIRST", "col": 3}, "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_FIRST"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@PID_INTEG"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@PID_INTEG", "col": 3}, "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_INTEG"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@PID_CALL"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@PID_CALL", "col": 3}, "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_CALL"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CLAMP_FIRST"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CLAMP_FIRST", "col": 3}, "stack": [{"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_FIRST"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CLAMP_IF"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CLAMP_IF", "col": 3}, "stack": [{"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_IF"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CLAMP_ELSIF"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CLAMP_ELSIF"}, "stack": [{"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_ELSIF"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CLAMP_RET"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CLAMP_RET", "col": 3}, "stack": [{"pou": "Clamp", "kind": "function", "instance": null, "location": {"file": "program.st", "line": "@CLAMP_RET"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@PID_AFTER"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@PID_AFTER", "col": 3}, "stack": [{"pou": "PID", "kind": "fb", "instance": "PROG0.motor1.pid", "location": {"file": "program.st", "line": "@PID_AFTER"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_AFTER"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_AFTER", "col": 5}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor1", "location": {"file": "program.st", "line": "@MOTOR_AFTER"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@CALL_M2"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@CALL_M2", "col": 3}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@CALL_M2"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_ELSE"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@MOTOR_ELSE", "col": 5}, "stack": [{"pou": "FB_Motor", "kind": "fb", "instance": "PROG0.motor2", "location": {"file": "program.st", "line": "@MOTOR_ELSE"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@TOTAL"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@TOTAL", "col": 3}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@TOTAL"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FOR"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@FOR"}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@FOR"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FOR_BODY"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@FOR_BODY", "col": 5}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@FOR_BODY"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@AFTER_LOOP"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@AFTER_LOOP", "col": 3}, "stack": [{"pou": "Cell", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@AFTER_LOOP"}}]}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"noEvent": "stopped", "forScans": 10},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 10}}}}
  ]
}
