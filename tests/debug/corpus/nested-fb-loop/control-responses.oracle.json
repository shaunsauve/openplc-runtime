{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "nested-fb-loop/control-responses",
  "corpus": "nested-fb-loop",
  "kind": "runtime",
  "criteria": ["A064"],
  "title": "Each control request answers once valid and once invalid with a typed code; stops of reason pause, breakpoint, step and entry each emit one reasoned event",
  "notes": "Correlation is checked by the harness session itself: a response is accepted only for its request's seq, so a wrong or constant correlation ID makes the step time out and DIVERGE. The exception reason is faults/exception-then-error. ASSUMED: a task argument of the wrong type is BAD_REQUEST and a second stop is NOT_RUNNING (ADR-003 D2).",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "next", "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "stepIn", "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "stepOut", "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": false, "error": "NOT_HALTED"}},
    {"request": "setBreakpoints", "args": {"file": "missing.st", "lines": [1]}, "expect": {"success": false, "error": "INVALID_LOCATION"}},
    {"request": "pause", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST"}},
    {"request": "pause", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause", "task": "Main"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"wait": {"wallMs": 300}},
    {"observe": "plant", "throughout": true, "note": "the plant sees the halt the stop event reports", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"request": "continue", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST"}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@MOTOR_PID"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@MOTOR_PID", "col": 5}, "task": "Main"}},
    {"request": "next", "args": {"task": 42}, "expect": {"success": false, "error": "BAD_REQUEST"}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@PID_FIRST", "col": 3}, "task": "Main"}},
    {"request": "stepOut", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main"}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main"}},
    {"request": "clearAllBreakpoints", "expect": {"success": true, "body": {"removed": 1}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"noEvent": "stopped", "forScans": 5},
    {"request": "restart", "args": {"kind": "cold", "startHalted": true}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "entry", "location": {"file": "program.st", "line": "@WITNESS"}, "task": "Main"}},
    {"request": "stop", "expect": {"success": true}},
    {"event": "runState", "withinMs": 1000, "expect": {"body": {"state": "STOPPED"}}},
    {"request": "stop", "expect": {"success": false, "error": "NOT_RUNNING"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ge": 0}}}}
  ]
}
