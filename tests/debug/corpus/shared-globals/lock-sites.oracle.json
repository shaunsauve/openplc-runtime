{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "shared-globals/lock-sites",
  "corpus": "shared-globals",
  "kind": "runtime",
  "criteria": ["A204"],
  "title": "A breakpoint inside F, the subscript call of a lock site, halts with no lock held; a breakpoint in the getter under the lock is skipped with an output event; all-stop pause completes",
  "notes": "Run per site S2, S3, S5, S6, S7 (F_BODY reached from that site) x 20, on the default build and the hoist-disabled build; this file is the S5 instance. The build-inspect half of A204 is generatedCpp below.",
  "setup": {"session": "controller", "haltMode": "allStop", "plant": {"samplePeriodMs": 5}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@S5"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "TaskA"}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@F_BODY"]}, "expect": {"success": true}},
    {"request": "stepIn", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "TaskA", "location": {"file": "program.st", "line": "@F_BODY", "col": 3},
      "stack": [{"pou": "F", "kind": "function", "instance": null}, {"pou": "ProgA", "kind": "program", "instance": "PROG_A", "location": {"file": "program.st", "line": "@S5"}}]}},
    {"request": "pause", "args": {"task": "TaskB"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 40, "note": "pause completes within one interval of the slower task (20 ms) plus margin", "expect": {"reason": "pause", "task": "TaskB"}},
    {"observe": "plant", "expect": {"witness": {"TaskA": {"~capture": "a"}, "TaskB": {"~capture": "b"}}}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "throughout": true, "expect": {"witness": {"TaskA": {"~ref": "a"}, "TaskB": {"~ref": "b"}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@GETTER"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "output", "withinMs": 1000, "note": "S4: the getter runs under the lock, so its hit never stops",
     "expect": {"body": {"category": "runtime", "text": {"~any": true}}}},
    {"noEvent": "stopped", "forMs": 500},
    {"observe": "status", "throughout": true, "expect": {"state": {"~oneOf": ["RUNNING", "PAUSED"]}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"inspect": "generatedCpp", "expect": {"lockLambdasWithProbe": 0, "lockLambdasWithNestedLock": 0, "s7CaptureSourceHoisted": true}},
    {"observe": "plant", "expect": {"scanDelta": {"TaskA": {"~ge": 1}, "TaskB": {"~ge": 1}}}}
  ]
}
