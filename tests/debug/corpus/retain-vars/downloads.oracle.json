{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "retain-vars/downloads",
  "corpus": "retain-vars",
  "kind": "runtime",
  "criteria": ["A215"],
  "title": "A warm full download, with and without a session, keeps the RETAIN counter and value from before the first scan; non-RETAIN start initial; a retype re-initialises only the retyped variable",
  "notes": "Aligned 2026-10-14 to ADR-006 D8 (N1). Uploads are the runtime REST upload with no retain option (warm by default, D8.2). A range [c, c+100] is written {~ref c, ~add 50, ~tol 50}: 'continues from c, never 0'. The 200-leaf half of A215 is retain-200/warm-download-and-restart.",
  "setup": {"session": "none", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%ID0": 42, "%ID1": 17}}},
  "steps": [
    {"wait": {"scans": 3}},
    {"observe": "plant", "note": "both counters at their plant-set values", "expect": {"outputs": {"%QD1": 42, "%QD2": 17, "%QD3": 42, "%QD4": 17}}},
    {"plant": {"set": {"%IX0.0": false}}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"outputs": {"%QD3": {"~gt": 42, "~capture": "c"}, "%QD1": 42}}},
    {"inject": "upload", "args": {"build": "variant-body.st"}, "note": "no session attached", "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "status", "note": "the status API variable read, not the upload response",
     "expect": {"fields": {"variables": {"PROG0.kept": 42, "PROG0.kcount": {"~ref": "c", "~add": 50, "~tol": 50}, "PROG0.plain": 0, "PROG0.pcount": {"~lt": 17}}}}},
    {"observe": "plant", "note": "the first scan already had the counter (kfirst, %QD5); the body edit runs (plain + 1)",
     "expect": {"outputs": {"%QD5": {"~ref": "c", "~add": 50, "~tol": 50}, "%QD3": {"~ref": "c", "~add": 50, "~tol": 50}, "%QD1": 42, "%QD2": 1}}},
    {"client": "s", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"observe": "plant", "expect": {"outputs": {"%QD3": {"~capture": "c2"}}}},
    {"inject": "upload", "args": {"build": "program.st"}, "note": "warm again, with a session attached", "expect": {"status": 200}},
    {"client": "s", "event": "programReplaced", "withinMs": 30000, "expect": {"body": {"cause": "download", "retain": "warm", "image": {"~any": true}}}},
    {"client": "s", "noEvent": "sessionEnded", "forMs": 1000},
    {"wait": {"scans": 3}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 42, "PROG0.kcount": {"~ref": "c2", "~add": 50, "~tol": 50}, "PROG0.plain": 0}}}},
    {"observe": "plant", "expect": {"outputs": {"%QD5": {"~ref": "c2", "~add": 50, "~tol": 50}, "%QD1": 42, "%QD2": 0}}},
    {"observe": "plant", "expect": {"outputs": {"%QD3": {"~capture": "c3"}}}},
    {"inject": "upload", "args": {"build": "variant-retype.st"}, "note": "kept DINT -> LINT", "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "status", "note": "the retyped variable starts initial; the other RETAIN variable is unchanged",
     "expect": {"fields": {"variables": {"PROG0.kept": 0, "PROG0.kcount": {"~ref": "c3", "~add": 50, "~tol": 50}}}}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 0, "%QD5": {"~ref": "c3", "~add": 50, "~tol": 50}}}}
  ]
}
