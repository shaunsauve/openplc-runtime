{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "retain-vars/downloads",
  "corpus": "retain-vars",
  "kind": "runtime",
  "criteria": ["A215", "A216"],
  "title": "A warm full download keeps a RETAIN value matched by path and type; a retype re-initialises it; an explicit cold download clears the store",
  "notes": "Uploads go through the runtime REST API (inject upload). The cold option's name is ADR-006's to fix; args.cold is the placeholder A216 assumes.",
  "setup": {"session": "none", "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setVariable", "args": {"path": "PROG0.kept", "value": 42}, "expect": {"success": true}},
    {"request": "setVariable", "args": {"path": "PROG0.plain", "value": 17}, "expect": {"success": true}},
    {"request": "detach", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42, "%QD2": 17}}},
    {"inject": "upload", "args": {"build": "variant-body.st"}},
    {"wait": {"scans": 3}},
    {"observe": "status", "note": "the status API variable read, not the upload response", "expect": {"fields": {"variables": {"PROG0.kept": 42, "PROG0.plain": 0}}}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42, "%QD2": 1}}},
    {"inject": "upload", "args": {"build": "variant-retype.st"}},
    {"wait": {"scans": 3}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"inject": "upload", "args": {"build": "program.st"}},
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setVariable", "args": {"path": "PROG0.kept", "value": 42}, "note": "A216's setup: the RETAIN counter at 42 again", "expect": {"success": true}},
    {"request": "detach", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42}}},
    {"inject": "upload", "args": {"build": "variant-body.st", "cold": true}},
    {"wait": {"scans": 2}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"inject": "restartRuntime", "args": {"kind": "warm"}},
    {"wait": {"scans": 2}},
    {"observe": "status", "note": "still initial: the store was cleared, not just memory", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ge": 1}}}}
  ]
}
