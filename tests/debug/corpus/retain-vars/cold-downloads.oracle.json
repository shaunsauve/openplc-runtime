{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "retain-vars/cold-downloads",
  "corpus": "retain-vars",
  "kind": "runtime",
  "criteria": ["A216"],
  "title": "A cold download resets RETAIN and clears the store; a pending cold wins over a later warm upload; a kept warm record survives a second unstarted upload; an unreadable record decodes nothing",
  "notes": "ADR-006 D8.2, D8.5 (N2). Uploads are the REST upload-file request: args.retain is its retain=warm|cold field, args.start false uploads without starting. The A215 setup (RETAIN at 42) is the plant load of %ID0. Cases (a)-(d) follow A216's Check.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%ID0": 42, "%ID1": 17}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"plant": {"set": {"%IX0.0": false}}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42}}},
    {"inject": "upload", "args": {"build": "variant-body.st", "retain": "cold"}, "note": "(a)", "expect": {"status": 200, "body": {"retain": "cold"}}},
    {"event": "programReplaced", "withinMs": 30000, "expect": {"body": {"cause": "download", "retain": "cold"}}},
    {"wait": {"scans": 3}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"observe": "plant", "note": "the first scan found the counter initial", "expect": {"outputs": {"%QD1": 0, "%QD5": 0}}},
    {"inject": "restartRuntime", "args": {}, "note": "(a) a further warm restart"},
    {"wait": {"scans": 3}},
    {"observe": "status", "note": "still initial: the store was cleared, not just the memory", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"plant": {"set": {"%IX0.0": true}}, "note": "(b) back to 42"},
    {"wait": {"scans": 3}},
    {"plant": {"set": {"%IX0.0": false}}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42}}},
    {"inject": "upload", "args": {"build": "variant-body.st", "retain": "cold", "start": false}, "expect": {"status": 200, "body": {"retain": "cold"}}},
    {"inject": "upload", "args": {"build": "program.st", "start": false}, "note": "a warm upload after a pending cold: cold wins", "expect": {"status": 200, "body": {"retain": "cold"}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "admin"}, "expect": {"status": 200}},
    {"event": "programReplaced", "withinMs": 30000, "expect": {"body": {"cause": "download", "retain": "cold"}}},
    {"wait": {"scans": 3}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"plant": {"set": {"%IX0.0": true}}, "note": "(c) A = program.st at 42"},
    {"wait": {"scans": 3}},
    {"plant": {"set": {"%IX0.0": false}}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 42}}},
    {"inject": "upload", "args": {"build": "variant-body.st", "start": false}, "note": "B, warm, not started: writes A's record", "expect": {"status": 200, "body": {"retain": "warm"}}},
    {"inject": "upload", "args": {"build": "variant-body2.st", "start": false}, "note": "C, warm: A's record is kept, not replaced by B's map", "expect": {"status": 200, "body": {"retain": "warm"}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "admin"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "status", "expect": {"fields": {"variables": {"PROG0.kept": 42}}}},
    {"observe": "plant", "note": "C runs (plain + 2) with A's value", "expect": {"outputs": {"%QD1": 42, "%QD2": 2}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/stop-plc", "user": "admin"}, "note": "(d)", "expect": {"status": 200}},
    {"inject": "writeFile", "args": {"path": "core/retain_prev/record.json", "content": {"version": 99, "kind": "warm", "md5": "0", "writer": "upload"}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "admin"}, "expect": {"status": 200}},
    {"event": "output", "withinMs": 5000, "expect": {"body": {"text": {"~contains": "RETAIN_NOT_KEPT"}}}},
    {"wait": {"scans": 3}},
    {"observe": "log", "expect": {"fields": {"lines": {"~contains": "record_unreadable"}}}},
    {"observe": "status", "note": "no value decoded from the unreadable record", "expect": {"fields": {"variables": {"PROG0.kept": 0}}}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 0}}}
  ]
}
