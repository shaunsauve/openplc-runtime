{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "retain-vars/restarts",
  "corpus": "retain-vars",
  "kind": "runtime",
  "criteria": ["A044"],
  "title": "Warm keeps RETAIN only; cold resets all; reset-to-origin clears the retained store; the session and its breakpoint survive each",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setVariable", "args": {"path": "PROG0.kept", "value": 111}, "expect": {"success": true}},
    {"request": "setVariable", "args": {"path": "PROG0.plain", "value": 222}, "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 111, "%QD2": 222}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@PLAIN"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint"}},
    {"request": "restart", "args": {"kind": "warm"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 3000, "note": "pre-set breakpoint hits after the restart",
     "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@PLAIN"}, "variables": {"PROG0.kept": 111, "PROG0.plain": 0, "PROG0.witness": 1}}},
    {"request": "restart", "args": {"kind": "cold"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 3000, "expect": {"reason": "breakpoint", "variables": {"PROG0.kept": 0, "PROG0.plain": 0}}},
    {"request": "setVariable", "args": {"path": "PROG0.kept", "value": 333}, "expect": {"success": true}},
    {"request": "restart", "args": {"kind": "reset"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 3000, "expect": {"reason": "breakpoint", "variables": {"PROG0.kept": 0}}},
    {"request": "restart", "args": {"kind": "cold"}, "note": "still initial after a further restart: the store was cleared", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 3000, "expect": {"reason": "breakpoint", "variables": {"PROG0.kept": 0}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 0, "%QD2": 0}}},
    {"observe": "status", "expect": {"fields": {"sessions": {"~len": 1}}}}
  ]
}
