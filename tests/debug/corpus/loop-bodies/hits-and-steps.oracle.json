{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "loop-bodies/hits-and-steps",
  "corpus": "loop-bodies",
  "kind": "runtime",
  "criteria": ["A039"],
  "title": "One hit per iteration; stepping off each body lands on the loop condition or after the loop",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FOR_BODY"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "variables": {"PROG0.i": 1, "PROG0.witness": {"~capture": "k"}}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "repeat": 9, "thenContinue": true, "withinMs": 1000, "note": "passes 2..10 of the same scan",
     "expect": {"reason": "breakpoint", "variables": {"PROG0.i": {"~range": [2, 10]}, "PROG0.witness": {"~ref": "k"}}}},
    {"event": "stopped", "withinMs": 1000, "note": "11th hit is the next scan's first pass",
     "expect": {"reason": "breakpoint", "variables": {"PROG0.i": 1, "PROG0.witness": {"~ref": "k", "~add": 1}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@FOR_LAST"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@FOR_LAST"}, "variables": {"PROG0.i": 1}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@FOR", "col": 3}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@WHILE_BODY"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "variables": {"PROG0.n": 0}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@WHILE", "col": 3}, "variables": {"PROG0.n": 1}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@REPEAT_BODY"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "variables": {"PROG0.r": 0}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@UNTIL", "col": 3}, "variables": {"PROG0.r": 2}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@EXIT"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@EXIT", "col": 7}, "variables": {"PROG0.j": 4, "PROG0.found": 4}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@TAIL", "col": 3}}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD1": 59}}}
  ]
}
