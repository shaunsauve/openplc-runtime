{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/tunnel-j4-j7",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A083"],
  "title": "J4 (stale build refused) and J7 (lose the debugger mid-halt) under the tunnel profile: J4 matches, a 30 s halt at 300 ms RTT does not time out, and the only timeout is the one J7 provokes",
  "notes": "J4 is plant-io/stale-build's steps and J7 plant-io/safe-stop-client-loss's, event bounds widened by 400 ms; J7 starts from J4's halt (J7's own attach and breakpoint are J4's). ASSUMED: the runtime log's heartbeat entries are read as the status state (no log read-back path yet).",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%IX0.1": true, "%IW0": 1234, "%ID0": 99999}}},
  "steps": [
    {"inject": "delayNetwork", "args": {"rttMs": 300, "jitterMs": 20}, "note": "the tunnel profile: one TCP port, 300 ms +/- 20 ms RTT (P11)"},
    {"request": "initialize", "args": {"identity": {"~build": "identity:variant-stale.st"}}, "expect": {"success": false, "error": "STALE_BUILD", "body": {"reason": "source", "image": {"md5": {"~any": true}, "buildId": {"~any": true}}, "client": {"md5": {"~any": true}}}}},
    {"observe": "status", "expect": {"fields": {"sessions": {"~len": 0}}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"wait": {"scans": 5}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 5}}}},
    {"request": "initialize", "args": {"identity": {"~build": "identity"}}, "expect": {"success": true, "body": {"comparison": "match", "image": {"md5": {"~any": true}, "buildId": {"~any": true}, "buildTime": {"~any": true}, "sourceHash": {"~any": true}}}}},
    {"observe": "status", "expect": {"fields": {"sessions": {"~len": 1}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@INT"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1400, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@INT", "col": 3}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~gt": 0}}}},
    {"wait": {"wallMs": 30000}},
    {"observe": "status", "note": "no heartbeat timeout J7 did not provoke", "expect": {"state": "HALTED_AT_BP"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}, "outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QW100": 1235, "%QD1": {"~capture": "c"}}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED", "fields": {"reason": "heartbeat_timeout", "location": {"file": "program.st", "line": {"~any": true}}}}},
    {"observe": "plant", "throughout": true, "note": "frozen scan count; nothing zeroed or reset", "expect": {"witness": {"Main": {"~ref": "w"}}, "outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QW100": 1235, "%QD1": {"~ref": "c"}}}},
    {"client": "next", "request": "initialize", "note": "a new client, same runtime process", "expect": {"success": true, "body": {"safeStop": {"reason": "heartbeat_timeout", "user": {"~any": true}, "location": {"~any": true}, "time": {"~any": true}}}}},
    {"observe": "plant", "throughout": true, "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QW100": 1235}}},
    {"inject": "restoreNetwork", "args": {}}
  ]
}
