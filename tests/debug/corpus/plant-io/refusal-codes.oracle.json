{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/refusal-codes",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A066"],
  "title": "Each refusal class answers its documented code with a plain-language message and leaves the runtime as it was",
  "notes": "ASSUMED: the session's controller may setLock (admin) and its own pause is then LOCKED; a rawFrame injection returns the response envelope. Not expressed: UNSUPPORTED (no MVP request is known to be absent from this build) and the session's start refused by the gate (needs a second credential without control). That each code is in the protocol spec is the doc cross-check, not this run.",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"client": "v2", "request": "initialize", "args": {"protocol": "2.0"}, "expect": {"success": false, "error": "PROTOCOL_VERSION", "body": {"message": {"~ne": ""}}}},
    {"client": "stale", "request": "initialize", "args": {"identity": {"~build": "identity:variant-stale.st"}}, "expect": {"success": false, "error": "STALE_BUILD", "body": {"message": {"~ne": ""}}}},
    {"client": "forged", "request": "initialize", "args": {"token": {"~token": "forged"}}, "expect": {"success": false, "error": "UNAUTHORISED", "body": {"message": {"~ne": ""}}}},
    {"request": "initialize", "expect": {"success": true}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"request": "setBreakpoints", "args": {"file": "missing.st", "lines": [1]}, "expect": {"success": false, "error": "INVALID_LOCATION", "body": {"message": {"~ne": ""}}}},
    {"request": "next", "expect": {"success": false, "error": "NOT_HALTED", "body": {"message": {"~ne": ""}}}},
    {"inject": "rawFrame", "args": {"frame": "oversize", "bytes": 2097152}, "expect": {"error": {"code": "LIMIT_EXCEEDED", "message": {"~ne": ""}}}},
    {"request": "setLock", "args": {"locked": true, "reason": "A066"}, "expect": {"success": true}},
    {"request": "pause", "expect": {"success": false, "error": "LOCKED", "body": {"message": {"~ne": ""}}}},
    {"request": "setLock", "args": {"locked": false}, "expect": {"success": true}},
    {"observe": "status", "expect": {"state": "RUNNING"}, "note": "no refusal changed the run state"},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"inject": "socket", "args": {"command": "START"}, "expect": "START:ERROR_SAFE_STOPPED"},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "held"}}}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "throughout": true, "expect": {"witness": {"Main": {"~ref": "held"}}}}
  ]
}
