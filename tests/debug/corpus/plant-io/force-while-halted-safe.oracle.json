{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/force-while-halted-safe",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A115"],
  "title": "Halted under the safe policy: a forced output reaches the plant during the halt, every other output stays at the policy value, and the next step reads a forced input",
  "notes": "ASSUMED: under `safe` the outputs a project does not list keep their hold value; only listed outputs are judged. A halt policy is per run, so hold and safe are two scenarios.",
  "setup": {"session": "controller", "haltPolicy": "safe", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}, "safeValues": {"%QW0": 100, "%QD2": 0, "%QW100": 0, "%QX0.0": false}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 9999, "reason": "A115 output"}, "expect": {"success": true}},
    {"request": "force", "args": {"path": "PROG0.in_enable", "value": true, "reason": "A115 input"}, "expect": {"success": true}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "note": "the forced output during the halt; the rest at the policy value; no scan ran", "expect": {"witness": {"Main": {"~ref": "w"}}, "outputs": {"%QW0": 9999, "%QD2": 0, "%QW100": 0, "%QX0.0": false}}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": true}, "note": "the forced input applies at the next copy-in (A114)"},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@IF"}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "location": {"file": "program.st", "line": "@THEN"}, "variables": {"PROG0.in_enable": true}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 9999, "%QX0.0": true}}},
    {"request": "unforceAll", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 5, "%QX0.0": false}}}
  ]
}
