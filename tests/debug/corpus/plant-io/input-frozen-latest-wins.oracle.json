{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/input-frozen-latest-wins",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A055"],
  "title": "While halted the program's input stays frozen and the session shows the pending value; the next copy-in takes the latest write",
  "notes": "ASSUMED: variables reports the image slot as `pending` beside the frozen `value` (ADR-004 D5.2 names both).",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IW0": 10}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 10}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "variables", "args": {"path": "PROG0.in_value"}, "expect": {"success": true, "body": {"value": 10}}},
    {"plant": {"sequence": [{"%IW0": 1}, {"%IW0": 2}, {"%IW0": 3}]}, "note": "three plugin writes during the halt"},
    {"wait": {"wallMs": 300}},
    {"request": "variables", "args": {"path": "PROG0.in_value"}, "expect": {"success": true, "body": {"value": 10, "pending": 3}}, "note": "frozen and pending (ADR-004 D5.2)"},
    {"observe": "plant", "throughout": true, "expect": {"outputs": {"%QW0": 10}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "variables", "args": {"path": "PROG0.in_value"}, "expect": {"success": true, "body": {"value": 3}}, "note": "the first scan after resume sees the latest write, never 1 or 2"},
    {"plant": {"sequence": [{"%IW0": 4}, {"%IW0": 5}, {"%IW0": 6}]}},
    {"wait": {"wallMs": 300}},
    {"request": "variables", "args": {"path": "PROG0.in_value"}, "expect": {"success": true, "body": {"value": 3, "pending": 6}}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "variables", "args": {"path": "PROG0.in_value"}, "expect": {"success": true, "body": {"value": 6}}, "note": "a cycle step copies in the latest write"},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "throughout": true, "note": "no sample shows 1, 2, 4 or 5", "expect": {"outputs": {"%QW0": {"~oneOf": [10, 3, 6]}}}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 6}}}
  ]
}
