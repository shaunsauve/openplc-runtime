{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/time-offset",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A185"],
  "title": "Over 60 s with halts of 2, 7 and 15 s the session reports a halt offset of 24 s, virtual time equal to the plant's, updates at >= 1 Hz running and halted, and the status API agrees",
  "notes": "partial: 'vt = plant scan count x interval' is judged through the plant's own virtual-time read while halted (frozen on both sides), not by multiplying; 1 Hz is judged as three successive time events within 3.5 s, not per timestamp; the CLI read is not this harness's. ADR-003 D4 `time {vt, wall, offset}`, ms; offset tolerance 4 task intervals.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"wallMs": 5000}},
    {"event": "time", "withinMs": 3500, "repeat": 3, "note": ">= 1 Hz while running"},
    {"request": "pause", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause"}},
    {"wait": {"wallMs": 2000}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"wallMs": 5000}},
    {"request": "pause", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause"}},
    {"wait": {"wallMs": 7000}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"wallMs": 5000}},
    {"request": "pause", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "pause"}},
    {"wait": {"wallMs": 15000}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"wallMs": 20000}},
    {"event": "time", "withinMs": 1500, "expect": {"body": {"offset": {"~approx": [24000, 400]}}}},
    {"observe": "status", "note": "the status API agrees with the session", "expect": {"fields": {"time": {"offset": {"~approx": [24000, 400]}}}}},
    {"observe": "plant", "expect": {"vtMs": {"Main": {"~ge": 30000}}}},
    {"request": "pause", "args": {"task": "Main"}, "expect": {"success": true}},
    {"note": "a fourth halt, after the offset is judged", "event": "stopped", "withinMs": 1000, "expect": {"reason": "pause"}},
    {"event": "time", "withinMs": 3500, "repeat": 3, "note": ">= 1 Hz while halted"},
    {"observe": "plant", "expect": {"vtMs": {"Main": {"~capture": "vt"}}}},
    {"event": "time", "withinMs": 1500, "note": "halted: the plant's virtual time and the session's agree", "expect": {"body": {"vt": {"~ref": "vt", "~add": 0, "~tol": 100}}}},
    {"request": "cycleStep", "args": {"task": "Main"}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step"}},
    {"event": "time", "withinMs": 1500, "note": "the Negative: a cycle step adds exactly one interval of virtual time", "expect": {"body": {"vt": {"~ref": "vt", "~add": 100, "~tol": 0}}}},
    {"request": "continue", "expect": {"success": true}}
  ]
}
