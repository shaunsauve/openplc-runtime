{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/safe-stop-outputs-held",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A206"],
  "title": "SAFE_STOPPED keeps the plant receiving the held outputs; an authorised start never zeroes them; STOP from SAFE_STOPPED zeroes",
  "notes": "ASSUMED: test users `control` (holds the control right) and `nocontrol` exist on the runtime; a refused REST start answers a non-200 status. `plugin` injections drive the corpus test plugin (`request_plc_start`, `segv_in_cycle_start`) and the VPP switch plugin (`run`, `stop`).",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%IX0.1": true, "%IW0": 1234, "%ID0": 99999}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "note": "every output kind non-zero, all initially 0", "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"wait": {"wallMs": 120000}},
    {"observe": "plant", "throughout": true, "note": "120 s of samples, every one at the held value", "expect": {"witness": {"Main": {"~ref": "w"}}, "outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}, "note": "no watchdog ERROR"},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "control"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "throughout": true, "note": "held until scan 1's copy-out, then the program's own (equal) values: never 0", "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}, "scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING"}},
    {"client": "next", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "next", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "next", "event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"client": "next", "inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/stop-plc", "user": "control"}, "expect": {"status": 200}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "note": "an explicit STOP from SAFE_STOPPED zeroes (ADR-004 D7.3 m)", "expect": {"outputs": {"%QX0.0": false, "%QW0": 0, "%QD2": 0, "%QD3": 0.0, "%QW100": 0, "%QW1": 0, "%QW2": 0, "%QW3": 0}}}
  ]
}
