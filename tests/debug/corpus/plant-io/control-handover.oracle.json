{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/control-handover",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A189"],
  "title": "Control is requested, declined, accepted, taken and released with the halt, breakpoints and force carried over, no safe-stop across any transfer, and a safe-stop P2 after a release nobody takes",
  "notes": "ADR-005 D4.9. Users: main (the endpoint's own token, A), userb (default user permissions, no take_control), userc (holds take_control). partial: the force's owner after transfer is not matched to A by name, and the editor and DAP repeats of the request flow are not this harness's. ASSUMED: the `control` event's body is {controller, observers, request: {from, outcome}}.",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 6}, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}},
  "steps": [
    {"request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 5150, "reason": "A189"}, "expect": {"success": true}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"client": "b", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:userb"}}, "expect": {"success": true}},
    {"client": "c", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:userc"}}, "expect": {"success": true}},
    {"client": "b", "request": "takeControl", "args": {}, "expect": {"success": false, "error": "FORBIDDEN"}, "note": "userb lacks take_control"},
    {"client": "b", "request": "requestControl", "args": {}, "expect": {"success": true}},
    {"event": "control", "withinMs": 1000, "note": "never answered", "expect": {"body": {"request": {"~any": true}}}},
    {"client": "b", "event": "control", "withinMs": 32000, "notBeforeMs": 29000, "note": "an unanswered request is a decline after 30 s; the floor is 30 s less the 1 s the preceding control step is allowed to take, because that step's clock starts after the request it announces", "expect": {"body": {"request": {"outcome": "declined"}}}},
    {"client": "b", "request": "requestControl", "args": {}, "expect": {"success": true}},
    {"event": "control", "withinMs": 1000, "expect": {"body": {"request": {"~any": true}}}},
    {"request": "answerControlRequest", "args": {"accept": false}, "expect": {"success": true}},
    {"client": "b", "event": "control", "withinMs": 1000, "expect": {"body": {"request": {"outcome": "declined"}}}},
    {"client": "b", "request": "requestControl", "args": {}, "expect": {"success": true}},
    {"event": "control", "withinMs": 1000, "expect": {"body": {"request": {"~any": true}}}},
    {"request": "answerControlRequest", "args": {"accept": true}, "expect": {"success": true}},
    {"client": "b", "event": "control", "withinMs": 1000, "expect": {"body": {"controller": {"~contains": "userb"}}}},
    {"client": "b", "request": "stackTrace", "args": {"task": "Main"}, "expect": {"success": true, "body": {"stackFrames": {"~contains": {"location": {"file": "program.st", "line": "@K"}}}}}},
    {"client": "b", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~len": 1}}}},
    {"observe": "status", "expect": {"state": "HALTED_AT_BP", "fields": {"breakpoints": {"~len": 1}}}},
    {"request": "continue", "expect": {"success": false, "error": "NOT_CONTROLLER"}, "note": "A is an observer now"},
    {"wait": {"wallMs": 8000}},
    {"observe": "status", "expect": {"state": "HALTED_AT_BP"}},
    {"client": "c", "request": "takeControl", "args": {}, "expect": {"success": true}},
    {"client": "c", "event": "control", "withinMs": 1000, "expect": {"body": {"controller": {"~contains": "userc"}}}},
    {"client": "c", "request": "stackTrace", "args": {"task": "Main"}, "expect": {"success": true, "body": {"stackFrames": {"~contains": {"location": {"file": "program.st", "line": "@K"}}}}}},
    {"client": "b", "request": "continue", "expect": {"success": false, "error": "NOT_CONTROLLER"}},
    {"wait": {"wallMs": 8000}},
    {"observe": "status", "expect": {"state": "HALTED_AT_BP"}},
    {"observe": "plant", "throughout": true, "note": "frozen across both transfers; no safe-stop; the force held", "expect": {"witness": {"Main": {"~ref": "w"}}, "outputs": {"%QW0": 5150}}},
    {"client": "c", "request": "releaseControl", "args": {}, "expect": {"success": true}},
    {"wait": {"wallMs": 7500}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED", "fields": {"reason": "heartbeat_timeout"}}},
    {"client": "adm", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:admin"}}, "expect": {"success": true}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "takeControl", "outcome": "ok"}}}}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "answerControlRequest", "outcome": "ok"}}}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ref": "w"}}}}
  ]
}
