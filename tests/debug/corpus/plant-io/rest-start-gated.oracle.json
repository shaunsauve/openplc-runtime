{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/rest-start-gated",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A208"],
  "title": "With the start gate set in SAFE_STOPPED, STOPPED and ERROR, a REST start without control is refused and one with control runs",
  "notes": "The audit log's content (refused entry naming the user, grant naming the granter) is fetched but not matched: the format has no contains-matcher over a log. ASSUMED: test users `control` (holds the control right) and `nocontrol` exist on the runtime; a refused REST start answers a non-200 status. `plugin` injections drive the corpus test plugin (`request_plc_start`, `segv_in_cycle_start`) and the VPP switch plugin (`run`, `stop`).",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%IX0.1": true, "%IW0": 1234, "%ID0": 99999}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "nocontrol"}, "expect": {"status": {"~ne": 200}}, "note": "gate set, SAFE_STOPPED"},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "throughout": true, "note": "the refused start ran no scan", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "control"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING", "fields": {"safeStop": {"~absent": true}}}},
    {"observe": "plant", "throughout": true, "note": "from SAFE_STOPPED: held values until scan 1's copy-out, never 0", "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}}},
    {"client": "second", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "second", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "second", "event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"client": "second", "inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/stop-plc", "user": "control"}, "expect": {"status": 200}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "nocontrol"}, "expect": {"status": {"~ne": 200}}, "note": "gate set, STOPPED after a STOP from SAFE_STOPPED"},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "throughout": true, "note": "the refused start ran no scan", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "control"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING", "fields": {"safeStop": {"~absent": true}}}},
    {"client": "third", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "third", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "third", "event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"client": "third", "inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"inject": "plugin", "args": {"name": "test-plugin", "action": "segv_in_cycle_start"}},
    {"wait": {"wallMs": 2000}},
    {"observe": "status", "expect": {"state": "ERROR"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "nocontrol"}, "expect": {"status": {"~ne": 200}}, "note": "gate set, ERROR with the hold (A207 route a)"},
    {"observe": "status", "expect": {"state": "ERROR"}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "throughout": true, "note": "the refused start ran no scan", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "control"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING", "fields": {"safeStop": {"~absent": true}}}},
    {"observe": "plant", "throughout": true, "note": "from ERROR: held values, never 0", "expect": {"outputs": {"%QX0.0": true, "%QW0": 1234, "%QD2": 99999, "%QD3": {"~approx": [617.0, 0.001]}, "%QW100": 1235, "%QW1": 1234, "%QW2": 1234, "%QW3": 2468}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/debug/audit", "user": "admin"}, "expect": {"status": 200, "body": {"~any": true}}, "note": "the refused entries name nocontrol and the grants name control; read by the audit criterion"}
  ]
}
