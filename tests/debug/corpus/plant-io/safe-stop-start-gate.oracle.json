{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/safe-stop-start-gate",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A059"],
  "title": "After a safe-stop every ungranted start is refused, through stops, uploads and reboots, until a control user starts it; the reason reaches the next client",
  "notes": "The runtime log entries for each refused start are not matched (no log read-back yet). ASSUMED: the status block and the attach response carry the record as `safeStop`; the hold file keeps the witness output across the SIGKILL boot. ASSUMED: test users `control` (holds the control right) and `nocontrol` exist on the runtime; a refused REST start answers a non-200 status. `plugin` injections drive the corpus test plugin (`request_plc_start`, `segv_in_cycle_start`) and the VPP switch plugin (`run`, `stop`).",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 3}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 16000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~capture": "w"}}}},
    {"wait": {"wallMs": 300000}},
    {"client": "next", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true, "body": {"safeStop": {"reason": "heartbeat_timeout", "user": {"~any": true}, "location": {"~any": true}, "time": {"~any": true}}}}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED", "fields": {"safeStop": {"reason": "heartbeat_timeout", "user": {"~any": true}, "location": {"~any": true}, "time": {"~any": true}}}}},
    {"observe": "plant", "throughout": true, "note": "5 min, frozen", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "socket", "args": {"command": "START"}, "expect": "START:ERROR_SAFE_STOPPED"},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "nocontrol"}, "expect": {"status": {"~ne": 200}}},
    {"inject": "plugin", "args": {"name": "test-plugin", "action": "request_plc_start"}},
    {"inject": "plugin", "args": {"name": "vpp-switch", "action": "run"}, "note": "switch reconciliation wanting RUN"},
    {"wait": {"wallMs": 1000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "throughout": true, "note": "every ungranted start refused", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "killRuntime", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 10000}},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}, "note": "the boot does not auto-start"},
    {"observe": "plant", "throughout": true, "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "plugin", "args": {"name": "vpp-switch", "action": "stop"}},
    {"inject": "plugin", "args": {"name": "vpp-switch", "action": "run"}},
    {"wait": {"wallMs": 1000}},
    {"observe": "plant", "throughout": true, "note": "a VPP switch RUN -> STOP -> RUN is refused", "expect": {"witness": {"Main": {"~ref": "w"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/stop-plc", "user": "control"}, "expect": {"status": 200}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "note": "STOP lands STOPPED with outputs 0", "expect": {"outputs": {"%QX0.0": false, "%QW0": 0, "%QD2": 0, "%QD3": 0.0, "%QW100": 0, "%QW1": 0, "%QW2": 0, "%QW3": 0}, "witness": {"Main": {"~capture": "w2"}}}},
    {"inject": "socket", "args": {"command": "START"}, "expect": "START:ERROR_SAFE_STOPPED", "note": "the gate outlives the STOP"},
    {"inject": "upload", "args": {"build": "program.st"}},
    {"inject": "plugin", "args": {"name": "vpp-switch", "action": "run"}},
    {"wait": {"wallMs": 1000}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"observe": "plant", "throughout": true, "note": "upload then switch RUN refused", "expect": {"witness": {"Main": {"~ref": "w2"}}}},
    {"inject": "killRuntime", "args": {"signal": "SIGKILL"}},
    {"wait": {"wallMs": 10000}},
    {"observe": "status", "expect": {"state": "STOPPED"}, "note": "boot from STOPPED with the gate: no auto-start"},
    {"observe": "plant", "throughout": true, "expect": {"witness": {"Main": {"~ref": "w2"}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/start-plc", "user": "control"}, "expect": {"status": 200}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING", "fields": {"safeStop": {"~absent": true}}}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/stop-plc", "user": "control"}, "expect": {"status": 200}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"inject": "plugin", "args": {"name": "vpp-switch", "action": "run"}},
    {"wait": {"scans": 3}},
    {"observe": "plant", "note": "the control start cleared the gate", "expect": {"scanDelta": {"Main": {"~ge": 3}}}},
    {"observe": "status", "expect": {"state": "RUNNING"}}
  ]
}
