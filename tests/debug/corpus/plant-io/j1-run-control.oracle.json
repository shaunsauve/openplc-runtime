{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "plant-io/j1-run-control",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A034", "A031"],
  "title": "J1 run-control and inspect beats (3-6, 13): a breakpoint stops before its statement with no plant output change, the stack and variables read while stopped match the program and the plant, a step lands on the next statement and changes the counter by one, a second breakpoint set while halted stops later in the same scan, and after the clear the program scans on",
  "notes": "J1 beats 3-6 and 13 on plant-io: break, inspect (stack, scopes, variables read while stopped and related to the plant), step, resume. Seeded red-proofs (tests/debug/plant/session_e2e.sh): SEED=late arms each breakpoint one probe late, so the first stop is at @IF, not @K; SEED=leafoff reads every leaf one past the asked one, so the values read while stopped are not the program's.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%IW0": 7, "%ID0": 70000}}},
  "steps": [
    {"request": "initialize", "args": {"identity": {"~build": "identity"}}, "expect": {"success": true, "body": {"comparison": "match", "capabilities": {"control": true, "probes": true}}}},
    {"wait": {"scans": 3}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]},
     "expect": {"success": true, "body": {"breakpoints": [{"verified": true, "line": "@K"}]}}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@K", "col": 3},
      "stack": [{"pou": "PlantIO", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@K", "col": 3},
                 "scopes": {"members": {"in_value": 7, "in_enable": true}}}],
      "variables": {"PROG0.witness": {"~capture": "kv"}, "PROG0.counter": {"~capture": "cv"}, "PROG0.in_dint": 70000}}},
    {"observe": "plant", "note": "ADR-004 D1.1: the plant holds the last complete scan, one behind the program's witness; the counter output is the pre-statement value",
     "expect": {"witness": {"Main": {"~capture": "k"}}, "outputs": {"%QD1": {"~capture": "c"}}}},
    {"observe": "plant", "note": "J1.4: the values read while stopped are the program's: witness k + 1 (this scan), counter = the published c", "expect": {"witness": {"Main": {"~ref": "kv", "~add": -1}}, "outputs": {"%QD1": {"~ref": "cv"}}}},
    {"wait": {"wallMs": 1500}},
    {"observe": "plant", "throughout": true, "note": "A034: no plant output change while stopped before K", "expect": {"witness": {"Main": {"~ref": "k"}}, "outputs": {"%QD1": {"~ref": "c"}}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main", "location": {"file": "program.st", "line": "@IF", "col": 3},
      "variables": {"PROG0.counter": {"~ref": "cv", "~add": 1}, "PROG0.witness": {"~ref": "kv"}}}},
    {"observe": "plant", "note": "the step's write reaches the plant only at the end of the scan", "expect": {"witness": {"Main": {"~ref": "k"}}, "outputs": {"%QD1": {"~ref": "c"}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K", "@L"]}, "expect": {"success": true, "body": {"breakpoints": [{"verified": true, "line": "@K"}, {"verified": true, "line": "@L"}]}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@L", "col": 3}}},
    {"observe": "plant", "throughout": true, "note": "A031(a): the same scan, plant scan count unchanged since the K stop", "expect": {"witness": {"Main": {"~ref": "k"}}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "task": "Main", "location": {"file": "program.st", "line": "@K"}}},
    {"observe": "plant", "note": "A034: the stepped scan completed and published its counter, once", "expect": {"witness": {"Main": {"~ref": "k", "~add": 1}}, "outputs": {"%QD1": {"~ref": "c", "~add": 1}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true, "body": {"breakpoints": []}}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "continued", "withinMs": 500},
    {"noEvent": "stopped", "forScans": 100},
    {"observe": "plant", "throughout": true, "note": "witness +1 per scan, no gap, no restart", "expect": {"scanDelta": {"Main": {"~ge": 100}}}}
  ]
}
