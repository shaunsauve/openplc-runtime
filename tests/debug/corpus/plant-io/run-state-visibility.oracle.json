{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/run-state-visibility",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A047"],
  "title": "Every run state reaches a second client as an event and the status API within 500 ms; a SIGSTOPped plc_main reads NOT_RESPONDING, a stopped webserver times out",
  "notes": "The watcher is the independent second client; the status read follows each event at once, so a transition later than 500 ms fails the runState step. Not expressed here: the cross-check against the runtime log and the web UI status page (no read-back for either). ERROR is faults/exception-then-error.",
  "setup": {"session": "controller", "params": {"P1_s": 2, "P2_s": 15}, "plant": {"samplePeriodMs": 10}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"client": "watcher", "request": "initialize", "args": {"role": "observer"}, "expect": {"success": true}},
    {"observe": "status", "expect": {"state": "RUNNING", "fields": {"staleness_ms": {"~le": 1000}}}},
    {"request": "pause", "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "PAUSED"}}},
    {"observe": "status", "expect": {"state": "PAUSED", "fields": {"by": {"~any": true}, "tasks": [{"task": "Main"}], "since": {"~any": true}, "location": {"file": "program.st", "line": {"~any": true}}}}},
    {"request": "continue", "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "RUNNING"}}},
    {"observe": "status", "expect": {"state": "RUNNING"}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "HALTED_AT_BP"}}},
    {"observe": "status", "expect": {"state": "HALTED_AT_BP", "fields": {"by": {"~any": true}, "tasks": [{"task": "Main"}], "since": {"~any": true}, "location": {"file": "program.st", "line": "@K"}}}},
    {"inject": "sigstopRuntime", "args": {"process": "plc_main"}},
    {"wait": {"wallMs": 2000}},
    {"observe": "status", "expect": {"state": "NOT_RESPONDING", "fields": {"staleness_ms": {"~ge": 1500}}}, "note": "never the cached HALTED_AT_BP as current (ADR-003 D9)"},
    {"wait": {"wallMs": 8000}},
    {"observe": "status", "expect": {"state": "NOT_RESPONDING", "fields": {"staleness_ms": {"~ge": 9500}}}},
    {"inject": "sigcontRuntime", "args": {"process": "plc_main"}},
    {"wait": {"wallMs": 1000}},
    {"observe": "status", "expect": {"state": "HALTED_AT_BP"}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "RUNNING"}}},
    {"inject": "sigstopRuntime", "args": {"process": "plc_main"}},
    {"wait": {"wallMs": 2000}},
    {"observe": "status", "expect": {"state": "NOT_RESPONDING", "fields": {"staleness_ms": {"~ge": 1500}}}, "note": "never the cached RUNNING as current"},
    {"inject": "sigcontRuntime", "args": {"process": "plc_main"}},
    {"wait": {"wallMs": 1000}},
    {"observe": "status", "expect": {"state": "RUNNING"}},
    {"inject": "sigstopRuntime", "args": {"process": "webserver"}},
    {"inject": "rest", "args": {"method": "GET", "path": "/api/status", "timeoutMs": 1000}, "expect": {"timedOut": true}, "note": "the status API times out: distinguishable from any halted answer"},
    {"inject": "sigcontRuntime", "args": {"process": "webserver"}},
    {"wait": {"wallMs": 1000}},
    {"request": "stop", "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "STOPPED"}}},
    {"observe": "status", "expect": {"state": "STOPPED"}},
    {"request": "restart", "args": {"kind": "warm"}, "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "RUNNING"}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "watcher", "event": "runState", "withinMs": 500, "expect": {"body": {"state": "HALTED_AT_BP"}}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}},
    {"client": "watcher", "event": "runState", "withinMs": 17000, "notBeforeMs": 13000, "expect": {"body": {"state": "SAFE_STOPPED"}}, "note": "13000 = P2 - P1: the core expires P2 after the last beat it received (ADR-005 D4.4) and the gateway forwards one at most once per P1, so the safe-stop cannot arrive sooner after a SIGKILL than that"},
    {"observe": "status", "expect": {"state": "SAFE_STOPPED"}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ge": 1}}}}
  ]
}
