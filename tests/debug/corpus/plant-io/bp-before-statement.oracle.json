{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 0,
  "scenario": "plant-io/bp-before-statement",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A034", "A031"],
  "title": "A breakpoint stops before its statement; a second one set while halted stops later in the same scan",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": true, "%IW0": 7, "%ID0": 70000}}},
  "steps": [
    {"request": "initialize", "args": {"identity": "build"}, "expect": {"success": true, "body": {"comparison": "match"}}},
    {"wait": {"scans": 3}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]},
     "expect": {"success": true, "body": {"breakpoints": [{"verified": true, "line": "@K"}]}}},
    {"event": "stopped", "withinMs": 1000, "expect": {
      "reason": "breakpoint", "task": "Main",
      "location": {"file": "program.st", "line": "@K", "col": 3},
      "stack": [{"pou": "PlantIO", "kind": "program", "instance": "PROG0", "location": {"file": "program.st", "line": "@K"}}],
      "variables": {"PROG0.witness": {"~capture": "k"}, "PROG0.counter": {"~capture": "c"}}}},
    {"observe": "plant", "note": "ADR-004 D1.1: the plant holds the last complete scan, k - 1; the counter output is the pre-statement value",
     "expect": {"witness": {"Main": {"~ref": "k", "~add": -1}}, "outputs": {"%QD1": {"~ref": "c"}}}},
    {"request": "next", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "step", "task": "Main",
      "location": {"file": "program.st", "line": "@IF", "col": 3},
      "variables": {"PROG0.counter": {"~ref": "c", "~add": 1}}}},
    {"observe": "plant", "expect": {"witness": {"Main": {"~ref": "k", "~add": -1}}, "outputs": {"%QD1": {"~ref": "c"}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K", "@L"]}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@L", "col": 3},
      "variables": {"PROG0.witness": {"~ref": "k"}}}},
    {"observe": "plant", "note": "A031(a): same scan, plant scan count unchanged since the K stop",
     "expect": {"witness": {"Main": {"~ref": "k", "~add": -1}}}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 1}},
    {"observe": "plant", "note": "the halted scan completes on resume and publishes the counter",
     "expect": {"witness": {"Main": {"~ge": 1}}, "outputs": {"%QD1": {"~gt": 0}}}},
    {"noEvent": "stopped", "forScans": 100},
    {"observe": "plant", "throughout": true, "note": "witness +1 per scan, no gap, no restart",
     "expect": {"scanDelta": {"Main": {"~ge": 100}}}}
  ]
}
