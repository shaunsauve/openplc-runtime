{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/permissions",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A125"],
  "title": "observe, control and modify are separate permissions checked on every request: each user can do exactly its own; revoking control mid-session refuses the next control request",
  "notes": "ADR-005 D3. Test users: obs_only (observe), ctl_only (observe, control), mod_only (observe, modify), admin; JWTs from runner --user-token. ASSUMED: an admin narrows a user's debug_permissions through PUT /api/debug/permissions/<user>.",
  "setup": {"session": "none", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}},
  "steps": [
    {"client": "o", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:obs_only"}}, "expect": {"success": false, "error": "FORBIDDEN"}},
    {"client": "o2", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:obs_only"}}, "expect": {"success": true}},
    {"client": "o2", "request": "subscribe", "args": {"paths": ["PROG0.counter"], "rateHz": 5}, "expect": {"success": true}},
    {"client": "c", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:ctl_only"}}, "expect": {"success": true}},
    {"client": "c", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "c", "event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"client": "c", "request": "force", "args": {"path": "PROG0.out_int", "value": 1001, "reason": "no modify"}, "expect": {"success": false, "error": "FORBIDDEN"}},
    {"client": "c", "request": "setVariable", "args": {"path": "PROG0.x", "value": 1001}, "expect": {"success": false, "error": "FORBIDDEN"}},
    {"client": "c", "request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"client": "c", "request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "note": "control took effect, modify did not", "expect": {"scanDelta": {"Main": {"~ge": 2}}, "outputs": {"%QW0": 5}}},
    {"client": "c", "request": "detach", "expect": {"success": true}},
    {"client": "m", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:mod_only"}}, "expect": {"success": true}},
    {"client": "m", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": false, "error": "FORBIDDEN"}},
    {"client": "m", "request": "pause", "args": {"task": "Main"}, "expect": {"success": false, "error": "FORBIDDEN"}},
    {"client": "m", "request": "force", "args": {"path": "PROG0.out_int", "value": 1002, "reason": "modify only"}, "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "note": "modify took effect; no halt", "expect": {"scanDelta": {"Main": {"~ge": 2}}, "outputs": {"%QW0": 1002}}},
    {"client": "m", "request": "unforceAll", "expect": {"success": true}},
    {"client": "m", "request": "detach", "expect": {"success": true}},
    {"client": "c2", "request": "initialize", "args": {"role": "controller", "token": {"~token": "user:ctl_only"}}, "expect": {"success": true}},
    {"client": "c2", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"client": "c2", "event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"client": "c2", "request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"client": "c2", "request": "continue", "expect": {"success": true}},
    {"inject": "rest", "args": {"method": "PUT", "path": "/api/debug/permissions/ctl_only", "user": "admin", "body": {"permissions": ["observe"]}}, "expect": {"status": 200}},
    {"client": "c2", "request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": false, "error": "FORBIDDEN"}, "note": "checked per request, not at attach"},
    {"wait": {"scans": 3}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 3}}, "outputs": {"%QW0": 5}}}
  ]
}
