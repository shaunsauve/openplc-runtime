{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/force-ttl",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A116"],
  "title": "Forces need a reason, carry owner, reason and remaining time, expire on the wall clock (during a halt too), survive a client reload, die with a runtime restart; TTL > 8 h is refused",
  "notes": "partial: the legacy 0x42 force (owner `legacy`, no TTL) is not driven: the format has no 0x41-0x45 PDU client (A080). ASSUMED: `ttl` and `remaining` are milliseconds.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 1111, "reason": ""}, "expect": {"success": false, "error": "BAD_REQUEST"}, "note": "empty reason"},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 1111, "reason": "too long", "ttl": 32400000}, "expect": {"success": false, "error": "RANGE_ERROR"}, "note": "9 h > the 8 h maximum"},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 1111, "reason": "ttl 10 s", "ttl": 10000}, "expect": {"success": true}},
    {"request": "listForces", "expect": {"success": true, "body": {"forces": {"~contains": {"path": "PROG0.out_int", "owner": {"~any": true}, "reason": "ttl 10 s", "remaining": {"~approx": [10000, 1000]}}}}}},
    {"wait": {"wallMs": 9700}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 1111}}},
    {"wait": {"wallMs": 500}},
    {"observe": "plant", "note": "ended within one scan of 10 s", "expect": {"outputs": {"%QW0": 5}}},
    {"request": "force", "args": {"path": "PROG0.out_dint", "value": 2222, "reason": "ttl across a halt", "ttl": 10000}, "expect": {"success": true}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"event": "forces", "withinMs": 12000, "note": "ADR-005 D5.2: the TTL runs on the wall clock, so it ends during the 30 s halt", "expect": {"body": {"list": {"~len": 0}}}},
    {"wait": {"wallMs": 19000}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"observe": "plant", "expect": {"outputs": {"%QD2": 7}}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 3333, "reason": "survives reload", "ttl": 600000}, "expect": {"success": true}},
    {"inject": "killClient", "args": {"signal": "SIGKILL"}, "note": "the client reloads"},
    {"client": "again", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "again", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~contains": {"path": "PROG0.out_int", "value": 3333}}}}},
    {"observe": "plant", "expect": {"outputs": {"%QW0": 3333}}},
    {"inject": "restartRuntime", "args": {}},
    {"wait": {"scans": 3}},
    {"client": "after", "request": "initialize", "args": {"role": "controller"}, "expect": {"success": true}},
    {"client": "after", "request": "listForces", "expect": {"success": true, "body": {"forces": {"~len": 0}}}},
    {"observe": "plant", "note": "gone after the restart (never persisted)", "expect": {"outputs": {"%QW0": 5}}}
  ]
}
