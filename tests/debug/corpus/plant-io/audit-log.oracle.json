{
  "$schema": "../oracle.schema.json",
  "format": "openplc-debug-oracle", "major": 1, "minor": 1,
  "scenario": "plant-io/audit-log",
  "corpus": "plant-io",
  "kind": "runtime",
  "criteria": ["A128"],
  "title": "Every control and modify action, refused ones included, is in the audit log with user, action, target, time and outcome; at least 10,000 entries are retained; the log cannot be deleted or edited",
  "notes": "partial: the entries' order is not checked (no ordered-subsequence matcher). The observer stream `obs` is opened on its refused request, as an observer. ASSUMED: auditRead's body is {entries: [{time, user, action, target, outcome}], total}; a refused outcome names its code.",
  "setup": {"session": "controller", "plant": {"samplePeriodMs": 10, "inputs": {"%IX0.0": false, "%IW0": 5, "%ID0": 7}}},
  "steps": [
    {"request": "initialize", "expect": {"success": true}},
    {"wait": {"scans": 2}},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": ["@K"]}, "expect": {"success": true}},
    {"event": "stopped", "withinMs": 1000, "expect": {"reason": "breakpoint", "location": {"file": "program.st", "line": "@K"}}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 1212, "reason": "A128"}, "expect": {"success": true}},
    {"request": "force", "args": {"path": "PROG0.out_int", "value": 99999, "reason": "out of INT range"}, "expect": {"success": false, "error": "RANGE_ERROR"}},
    {"client": "obs", "request": "continue", "expect": {"success": false, "error": "NOT_CONTROLLER"}, "note": "an observer's refused control"},
    {"request": "setBreakpoints", "args": {"file": "program.st", "lines": []}, "expect": {"success": true}},
    {"request": "continue", "expect": {"success": true}},
    {"request": "unforce", "args": {"path": "PROG0.out_int"}, "expect": {"success": true}},
    {"client": "adm", "request": "initialize", "args": {"role": "observer", "token": {"~token": "user:admin"}}, "expect": {"success": true}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "force", "target": "PROG0.out_int", "outcome": "ok", "user": {"~any": true}, "time": {"~any": true}}}}}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "force", "target": "PROG0.out_int", "outcome": {"~contains": "RANGE_ERROR"}}}}}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "continue", "outcome": {"~contains": "NOT_CONTROLLER"}}}}}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"entries": {"~contains": {"action": "setBreakpoints", "outcome": "ok"}}}}},
    {"loop": 10500, "steps": [{"request": "setVariable", "args": {"path": "PROG0.x", "value": 3}, "expect": {"success": true}}]},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"total": {"~ge": 10000}}}},
    {"inject": "rest", "args": {"method": "DELETE", "path": "/api/debug/audit", "user": "admin"}, "expect": {"status": {"~oneOf": [403, 405]}}},
    {"inject": "rest", "args": {"method": "PUT", "path": "/api/debug/audit", "user": "admin", "body": {"entries": []}}, "expect": {"status": {"~oneOf": [403, 405]}}},
    {"client": "adm", "request": "auditRead", "args": {}, "expect": {"success": true, "body": {"total": {"~ge": 10000}, "entries": {"~contains": {"action": "force", "outcome": "ok"}}}}},
    {"observe": "plant", "expect": {"scanDelta": {"Main": {"~ge": 1}}}}
  ]
}
